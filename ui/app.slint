// TX Open Studio — preset switcher UI

import { ListView } from "std-widgets.slint";

// "Hardware controller" palette: dark chassis, OLED insets, amber accent.
export global Theme {
    // Page around the chassis (radial: lighter centre, near-black edges).
    out property <brush> page: @radial-gradient(circle, #17181c 0%, #0a0b0d 70%);
    out property <color> bg: #0a0b0d;
    // Chassis body and its vertical sheen.
    out property <color> body: #141518;
    out property <color> body-top: #1b1d21;
    out property <color> body-bottom: #101114;
    // OLED / inset panels.
    out property <color> oled: #090a0c;
    // Bevel highlight line and near-black outer edge.
    out property <color> bevel: #2c2f36;
    out property <color> edge: #08090a;
    // Raised "hw" button gradient, and its pressed (inverted) version.
    out property <color> hw-top: #2b2e35;
    out property <color> hw-bottom: #1b1d21;
    out property <color> hw-pressed-top: #17191c;
    out property <color> hw-pressed-bottom: #202329;
    out property <color> hw-ink: #c9ccd3;
    out property <color> hw-ink-hover: #ffffff;
    out property <color> surface: #101114;
    out property <color> surface-alt: #0e0f12;
    out property <color> soft: #17191c;
    out property <color> field: #17191c;
    out property <color> hover: #22252a;
    out property <color> selected: #1c1e22;
    out property <color> border: #2a2d33;
    out property <color> selected-border: #f59e0b;
    out property <color> muted: #8d929c;
    out property <color> ink: #d7dae0;
    out property <color> secondary-ink: #c9ccd3;
    out property <color> accent: #f59e0b;
    out property <color> accent-hover: #fbbf24;
    out property <color> amber-glow: #f59e0b80;
    // OLED display: preset name ink and the display's black edge.
    out property <color> oled-ink: #ece2cf;
    out property <color> oled-edge: #000000;
    // Soft warm glow behind the OLED preset name.
    out property <color> oled-glow: #ffcf8a;
    // Knob ring track, cap gradient and pointer.
    out property <color> knob-track: #2a2d33;
    out property <color> knob-cap-top: #3d4149;
    out property <color> knob-cap-bottom: #1c1e22;
    out property <color> knob-pointer: #f2f3f5;
    // Faceplate trace joining an EQ band's gain and frequency knobs.
    out property <color> trace: #4a4e57;
    // Mic 2 on the cab mic pad (Mic 1 uses the amber accent).
    out property <color> mic2: #3aa8a0;
    // Dark text on solid amber.
    out property <color> on-accent: #111111;
    out property <color> ok: #22c55e;
    out property <color> led-off: #2a2d33;
    out property <color> error: #ef4444;
    // "Modified" markers: solid amber.
    out property <color> changed: #f59e0b;
    // Status bar strip.
    out property <color> status-bg: #0c0d0f;
    out property <color> status-line: #060708;
    out property <color> status-ink: #a3a8b2;
    // Monospaced font for technical texts (status bar, values, small
    // uppercase labels). Switch to "JetBrains Mono" once installed.
    out property <string> mono-font: "Noto Sans Mono";
}

// One row of the (filtered) preset list: preset number (1..150), short id
// ("41B": 0-based bank + slot), name ("" until loaded), character and its
// colour group `kind` (0 = none; see character_kind in main.rs).
export struct PresetRow {
    preset: int,
    id: string,
    name: string,
    character: string,
    kind: int,
}

// Value formatting shared by knobs and labels (exported so Rust tests can
// call it).
export global Format {
    // Frequency label: "180", "750", "1.6K", "4K": from 1 kHz on in kHz
    // with one decimal, a trailing .0 dropped.
    pure public function hz(v: float) -> string {
        if (v < 1000) {
            return "\{round(v)}";
        }
        let tenths = round(v / 100);
        return "\{floor(tenths / 10)}" + (mod(tenths, 10) == 0 ? "" : ".\{mod(tenths, 10)}") + "K";
    }
    // Program number as the pedal shows it in PC+Name mode: preset - 1,
    // zero-padded to 3 (preset 84 → "083", hardware-checked). Presets
    // 129..150 are PC 0..21 in bank 1 over MIDI; whether the pedal's
    // display wraps there too is unchecked, so this stays continuous.
    // Always one decimal ("4.2", "0.0", "-1.5"): mic pad readouts.
    pure public function one(v: float) -> string {
        let t = round(abs(v) * 10);
        return (v <= -0.05 ? "-" : "") + "\{floor(t / 10)}.\{mod(t, 10)}";
    }
    pure public function ordinal(preset: int) -> string {
        let pc = preset - 1;
        return (pc < 10 ? "00" : pc < 100 ? "0" : "") + pc;
    }
}

// Muted colours per preset character group, shared by list and OLED.
export global CharacterColors {
    pure public function of(kind: int) -> color {
        if (kind == 1) { return #4a8a6a; } // clean
        if (kind == 2) { return #a07d1c; } // crunch
        if (kind == 3) { return #b0632c; } // drive
        if (kind == 4) { return #a84a42; } // high gain / lead
        if (kind == 5) { return #8a5bb0; } // stomp
        if (kind == 6) { return #3d78b8; } // bass
        if (kind == 7) { return #8a7a50; } // acoustic
        return Theme.muted;
    }
}

// OLED text with a faked glow: four faint copies offset by 1.5px behind
// the real text (Slint Text has no shadow). Elides like the real text.
component GlowText inherits Rectangle {
    in property <string> text;
    in property <color> ink;
    in property <color> glow;
    in property <float> glow-alpha: 0.15;
    in property <length> font-size: 12px;
    in property <int> font-weight: 400;
    in property <string> font-family;
    in property <length> letter-spacing: 0px;

    // Soft halo wash behind the crisp glyphs: a radial gradient stretched
    // over the line (the user's preferred look).
    halo := Rectangle {
        visible: root.glow-alpha > 0;
        x: label.x - label.height;
        y: label.y + label.height / 2 - self.height / 2;
        width: label.width + label.height * 2;
        height: label.height * 2.4;
        background: @radial-gradient(circle,
            root.glow.with-alpha(root.glow-alpha) 0%,
            root.glow.with-alpha(root.glow-alpha * 0.45) 35%,
            root.glow.with-alpha(0.0) 72%);
    }

    HorizontalLayout {
        label := Text {
            min-width: 0px;
            text: root.text;
            color: root.ink;
            font-size: root.font-size;
            font-weight: root.font-weight;
            font-family: root.font-family;
            letter-spacing: root.letter-spacing;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}

// Compact OLED chip: outlined in `tint`, or solid with dark text.
component OledChip inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.accent;
    in property <bool> solid: false;

    horizontal-stretch: 0;
    background: root.solid ? root.tint : transparent;
    border-radius: 3px;
    border-width: 1px;
    border-color: root.solid ? root.tint : root.tint.with-alpha(0.6);

    HorizontalLayout {
        padding-left: 5px;
        padding-right: 5px;
        padding-top: 2px;
        padding-bottom: 2px;
        Text {
            text: root.text;
            color: root.solid ? Theme.on-accent : root.tint.brighter(0.35);
            font-size: 9px;
            font-weight: root.solid ? 600 : 500;
            font-family: Theme.mono-font;
            letter-spacing: 0.4px;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
}

// Raised hardware-style button: vertical gradient, near-black edge, top
// highlight and a hard 2px drop. Pressed (or `checked`) it sinks: darker
// inverted gradient, no drop, content shifted down 2px. Content goes in as
// children; `hover` lets it brighten its text.
component HwButton inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> enabled: true;
    in property <length> radius: 6px;
    out property <bool> hover: ta.has-hover;
    out property <bool> down: ta.pressed || root.checked;
    property <length> shift: 0px;
    callback clicked();

    border-radius: root.radius;
    border-width: 1px;
    border-color: Theme.edge;
    background: @linear-gradient(180deg, Theme.hw-top 0%, Theme.hw-bottom 100%);
    drop-shadow-offset-y: 2px;
    drop-shadow-color: Theme.edge;
    opacity: root.enabled ? 1 : 0.4;

    // Top highlight (inset 0 1px 0 rgba(255,255,255,.1)).
    Rectangle {
        x: root.radius / 2;
        y: 1px;
        width: parent.width - root.radius;
        height: 1px;
        background: #ffffff1a;
        visible: !root.down;
    }

    Rectangle {
        y: root.shift;
        width: parent.width;
        height: parent.height;
        @children
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }

    states [
        sunk when root.down: {
            background: @linear-gradient(180deg, Theme.hw-pressed-top 0%, Theme.hw-pressed-bottom 100%);
            drop-shadow-offset-y: 0px;
            shift: 2px;
        }
    ]
}

// Text button on the hardware look (std-widgets don't follow the palette).
component StyledButton inherits HwButton {
    in property <string> text;
    in property <length> font-size: 16px;
    in property <int> font-weight: 600;
    in property <bool> active: false;

    min-height: 22px;
    min-width: 22px;

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.accent : (root.hover ? Theme.hw-ink-hover : Theme.hw-ink);
        font-size: root.font-size;
        font-weight: root.font-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Tab of the controller deck: sunk with an amber label when selected;
// module tabs show the module's on/off LED before the label.
component TabButton inherits HwButton {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> has-led: false;
    in property <bool> led-on: false;

    height: 26px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    checked: root.selected;

    HorizontalLayout {
        alignment: center;
        spacing: 4px;
        if root.has-led: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 5px;
                height: 5px;
                border-radius: 2.5px;
                background: root.led-on ? Theme.ok : Theme.led-off;
                drop-shadow-blur: root.led-on ? 5px : 0px;
                drop-shadow-color: root.led-on ? Theme.ok.with-alpha(0.9) : transparent;
            }
        }
        // Elides instead of widening the tab, so nine tabs always share
        // the row equally.
        Text {
            min-width: 0px;
            text: root.label;
            color: root.selected ? Theme.accent : (root.hover ? Theme.hw-ink-hover : Theme.status-ink);
            font-size: 9px;
            font-weight: 500;
            font-family: Theme.mono-font;
            letter-spacing: 0.4px;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }
}

// Small uppercase module title at the left of a tray page header.
component ModuleTitle inherits Text {
    horizontal-stretch: 1;
    min-width: 0px;
    color: Theme.hw-ink;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 1.6px;
    vertical-alignment: center;
    overflow: elide;
    wrap: no-wrap;
}

// Rotary knob with label above and value below. Vertical drag changes the
// value in `step` increments (a full sweep is ~150 px). `edited` fires only
// for user drags, not when the value is set programmatically (e.g. read back
// from the pedal). Shown with `decimals` (0 or 1) and a `unit` suffix.
// Double-click resets to `default-value` (sent like a normal edit).
component Knob inherits VerticalLayout {
    in property <string> label;
    in-out property <float> value: 5;
    in property <float> min-value: 0;
    in property <float> max-value: 10;
    in property <float> step: 0.1;
    in property <float> default-value: 5;
    in property <int> decimals: 1;
    in property <string> unit;
    // Show the value as a frequency ("750", "1.6K"; see Format.hz).
    in property <bool> hz: false;
    in property <length> value-font-size: 12px;
    in property <length> size: 48px;
    // false: display only (no drag, no double-click reset), dimmed.
    in property <bool> enabled: true;
    callback edited(float);
    out property <bool> active: ta.pressed;
    // Sweep of 270°: min → -135°, max → +135° (0° = straight up).
    property <float> frac: clamp((root.value - root.min-value) / max(root.max-value - root.min-value, 0.0001), 0, 1);
    property <angle> sweep: (-135 + root.frac * 270) * 1deg;
    property <int> tenths: round(root.value * 10);
    property <int> abs-tenths: abs(root.tenths);
    // decimals 2: always two places ("0.70"; EQ mid Q).
    property <int> abs-hundredths: abs(round(root.value * 100));
    property <string> number: root.hz ? Format.hz(root.value) : root.decimals == 2
        ? (root.value < -0.005 ? "-" : "") + "\{floor(root.abs-hundredths / 100)}."
            + (mod(root.abs-hundredths, 100) < 10 ? "0" : "") + "\{mod(root.abs-hundredths, 100)}"
        : root.decimals == 0
        ? "\{round(root.value)}"
        : (root.tenths < 0 ? "-" : "") + "\{floor(root.abs-tenths / 10)}"
            + (mod(root.abs-tenths, 10) == 0 ? "" : ".\{mod(root.abs-tenths, 10)}");
    property <float> drag-start: 0;

    spacing: 4px;
    min-width: root.size;
    horizontal-stretch: 1;

    // No label row at all when empty (small EQ frequency knobs).
    if root.label != "": Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        horizontal-alignment: center;
        overflow: elide;
        wrap: no-wrap;
    }

    // Top of the dial row (for drawing next to the dial, see EqPair).
    out property <length> dial-top: dial-row.y;

    dial-row := HorizontalLayout {
        alignment: center;

        // 270° arc ring (track + amber value arc), raised cap and a white
        // pointer. Paths use a fixed 100×100 viewbox so everything scales
        // with `size`; angles: 0° = up, clockwise positive.
        dial := Rectangle {
            width: root.size;
            height: root.size;

            property <float> ring-r: 44;
            property <length> ring-w: max(2px, root.size * 0.08);

            // Track: full sweep -135° → +135°.
            Path {
                width: 100%;
                height: 100%;
                viewbox-width: 100;
                viewbox-height: 100;
                stroke: Theme.knob-track;
                stroke-width: dial.ring-w;
                MoveTo {
                    x: 50 + dial.ring-r * sin(-135deg);
                    y: 50 - dial.ring-r * cos(-135deg);
                }
                ArcTo {
                    x: 50 + dial.ring-r * sin(135deg);
                    y: 50 - dial.ring-r * cos(135deg);
                    radius-x: dial.ring-r;
                    radius-y: dial.ring-r;
                    large-arc: true;
                    sweep: true;
                }
            }
            // Value arc: -135° → current value.
            if root.frac > 0.004: Path {
                width: 100%;
                height: 100%;
                viewbox-width: 100;
                viewbox-height: 100;
                stroke: Theme.accent;
                stroke-width: dial.ring-w;
                MoveTo {
                    x: 50 + dial.ring-r * sin(-135deg);
                    y: 50 - dial.ring-r * cos(-135deg);
                }
                ArcTo {
                    x: 50 + dial.ring-r * sin(root.sweep);
                    y: 50 - dial.ring-r * cos(root.sweep);
                    radius-x: dial.ring-r;
                    radius-y: dial.ring-r;
                    large-arc: root.frac > 2 / 3;
                    sweep: true;
                }
            }

            // Cap: lighter top for a domed look; amber glow while dragged.
            Rectangle {
                width: root.size * 0.72;
                height: self.width;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                border-radius: self.width / 2;
                background: @linear-gradient(180deg, Theme.knob-cap-top 0%, Theme.knob-cap-bottom 75%);
                border-width: 1px;
                border-color: ta.has-hover || ta.pressed ? Theme.bevel : Theme.edge;
                drop-shadow-blur: ta.pressed ? 8px : 3px;
                drop-shadow-offset-y: ta.pressed ? 0px : 1px;
                drop-shadow-color: ta.pressed ? Theme.amber-glow : #00000099;
            }

            // Pointer line, rotated with the value.
            Path {
                width: 100%;
                height: 100%;
                viewbox-width: 100;
                viewbox-height: 100;
                stroke: Theme.knob-pointer;
                stroke-width: max(1.5px, root.size * 0.045);
                MoveTo {
                    x: 50 + 14 * sin(root.sweep);
                    y: 50 - 14 * cos(root.sweep);
                }
                LineTo {
                    x: 50 + 31 * sin(root.sweep);
                    y: 50 - 31 * cos(root.sweep);
                }
            }

            opacity: root.enabled ? 1 : 0.55;
            ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? ns-resize : default;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.drag-start = root.value;
                    }
                }
                double-clicked => {
                    root.value = root.default-value;
                    root.edited(root.default-value);
                }
                moved => {
                    if (self.pressed) {
                        let v = root.drag-start + (self.pressed-y - self.mouse-y) / 150px * (root.max-value - root.min-value);
                        let nv = clamp(round(v / root.step) * root.step, root.min-value, root.max-value);
                        if (nv != root.value) {
                            root.value = nv;
                            root.edited(nv);
                        }
                    }
                }
            }
        }
    }

    Text {
        text: root.number + root.unit;
        color: Theme.secondary-ink;
        font-size: root.value-font-size;
        font-family: Theme.mono-font;
        horizontal-alignment: center;
        overflow: elide;
        wrap: no-wrap;
    }
}

// One EQ band, Two Notes style: the band's gain knob (MIDI CC) with a
// small frequency knob (serial) diagonally above-right of it, joined by a
// thin faceplate trace. Range printed above the small knob, its value in
// Hz/kHz below; steps 5 Hz below 1 kHz, 50 Hz above (fx::freq_step). The
// frequency knob is locked and dimmed until plausible values were read
// (`freq-enabled`), so nothing guessed is written.
component EqPair inherits Rectangle {
    in property <string> label;
    in-out property <float> gain;
    callback gain-edited(float);
    out property <bool> active: big.active;
    in-out property <float> freq;
    in property <float> freq-min;
    in property <float> freq-max;
    in property <float> freq-default;
    in property <bool> freq-enabled: true;
    callback freq-edited(float);
    // Optional Q knob (mid band, Two Notes style): mirrors the frequency
    // knob up-left of the gain knob, with its own trace.
    in property <bool> has-q: false;
    in-out property <float> q;
    in property <float> q-default;
    in property <bool> q-enabled: true;
    callback q-edited(float);

    height: 132px;
    // Dial centres: the big one left of centre so a two-knob pair is
    // balanced (centred with a Q knob), the small ones offset up-right
    // (frequency) and up-left (Q).
    property <length> cx: self.width / 2 - (root.has-q ? 0px : 16px);
    property <length> qcx: self.cx - 52px;
    property <length> cy: big.y + big.dial-top + 36px;
    property <length> scx: self.cx + 52px;
    property <length> scy: self.cy - 58px;
    // Trace ends just outside both rings: big rim at 50° (clear of the
    // label), small rim at its bottom-left (225°).
    property <length> x0: self.cx + 37px * sin(50deg);
    property <length> y0: self.cy - 37px * cos(50deg);
    property <length> x1: self.scx - 15px * sin(45deg);
    property <length> y1: self.scy + 15px * cos(45deg);
    // Mirror for the Q trace: big rim at -50°, Q rim at its bottom-right.
    property <length> qx0: self.cx - 37px * sin(50deg);
    property <length> qx1: self.qcx + 15px * sin(45deg);

    // Quarter curve: leaves the big knob upwards, meets the small one
    // horizontally.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: Theme.trace;
        stroke-width: 1px;
        MoveTo {
            x: root.x0 / 1px;
            y: root.y0 / 1px;
        }
        QuadraticTo {
            control-x: root.x0 / 1px;
            control-y: root.y1 / 1px;
            x: root.x1 / 1px;
            y: root.y1 / 1px;
        }
    }

    if root.has-q: Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: Theme.trace;
        stroke-width: 1px;
        MoveTo {
            x: root.qx0 / 1px;
            y: root.y0 / 1px;
        }
        QuadraticTo {
            control-x: root.qx0 / 1px;
            control-y: root.y1 / 1px;
            x: root.qx1 / 1px;
            y: root.y1 / 1px;
        }
    }

    if root.has-q: Text {
        x: root.qcx - self.width / 2;
        y: root.scy - 14px - self.height - 1px;
        text: "Q";
        color: Theme.muted;
        font-size: 8px;
        font-family: Theme.mono-font;
        wrap: no-wrap;
    }

    if root.has-q: Knob {
        x: root.qcx - self.width / 2;
        y: root.scy - 14px;
        width: 40px;
        height: self.preferred-height;
        label: "";
        size: 28px;
        value-font-size: 10px;
        enabled: root.q-enabled;
        min-value: 0.2;
        max-value: 3.0;
        step: 0.05;
        decimals: 2;
        default-value: root.q-default;
        value <=> root.q;
        edited(v) => { root.q-edited(v); }
    }

    big := Knob {
        x: root.cx - self.width / 2;
        y: root.height - self.height;
        width: 80px;
        height: self.preferred-height;
        size: 72px;
        label: root.label;
        value <=> root.gain;
        edited(v) => { root.gain-edited(v); }
    }

    Text {
        x: root.scx - self.width / 2;
        y: small.y - self.height - 1px;
        text: "Hz";
        color: Theme.muted;
        font-size: 8px;
        font-family: Theme.mono-font;
        wrap: no-wrap;
    }

    small := Knob {
        x: root.scx - self.width / 2;
        y: root.scy - 14px;
        width: 40px;
        height: self.preferred-height;
        label: "";
        size: 28px;
        hz: true;
        value-font-size: 10px;
        enabled: root.freq-enabled;
        min-value: root.freq-min;
        max-value: root.freq-max;
        step: root.freq >= 1000 ? 50 : 5;
        decimals: 0;
        default-value: root.freq-default;
        value <=> root.freq;
        edited(v) => { root.freq-edited(v); }
    }
}

// A titled group on the GLOBAL tab: thin border with the title sitting on
// it like a faceplate legend; children are laid out in one row.
component GlobalGroup inherits Rectangle {
    in property <string> title;
    // Vertical padding (the AMP tab trims it to fit the tray).
    in property <length> pad-top: 10px;
    in property <length> pad-bottom: 8px;
    // space-between pushes the outer children toward the group's edges
    // (used by the EQ group so Bass/Treble sit near the borders).
    in property <LayoutAlignment> content-alignment: LayoutAlignment.center;

    border-width: 1px;
    border-color: Theme.border;
    border-radius: 6px;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: root.pad-top;
        padding-bottom: root.pad-bottom;
        spacing: 6px;
        alignment: root.content-alignment;
        @children
    }

    Rectangle {
        x: 8px;
        y: -6px;
        width: legend.preferred-width + 8px;
        height: 12px;
        background: Theme.surface;
        legend := Text {
            x: 4px;
            height: parent.height;
            text: root.title;
            color: Theme.muted;
            font-size: 8px;
            font-weight: 600;
            font-family: Theme.mono-font;
            letter-spacing: 1.2px;
            vertical-alignment: center;
        }
    }
}

// Mic positions in front of the speaker, as a wedge fanning out of it
// ("cheese wedge with rays"): Mic 1 amber, Mic 2 teal. Polar mapping
// around the apex (ax, ay) at the speaker:
//     angle  = -alpha + X/10 * 2 * alpha   (X 0 upper edge, 10 lower edge)
//     radius = r0 + Z/10 * (rmax - r0)     (Z 0 at the cone, 10 far arc)
// inverted with atan2 / hypot when dragging, clamped to the wedge. The
// apex itself is hidden behind the speaker; r0 keeps X readable even at
// Z 0. The wedge, speaker and hints are static vector geometry; only the
// dots and readouts depend on the values.
component MicPad inherits Rectangle {
    in property <bool> enabled: true;
    in-out property <float> m1x;
    in-out property <float> m1z;
    in-out property <float> m2x;
    in-out property <float> m2z;
    in property <float> m1x-default;
    in property <float> m1z-default;
    in property <float> m2x-default;
    in property <float> m2z-default;
    // which: 0 mic 1 X, 1 mic 1 Z, 2 mic 2 X, 3 mic 2 Z.
    callback edited(int, float);

    opacity: root.enabled ? 1 : 0.45;

    // Margin around the figure: a dot's glow ring (9 px) plus the outline
    // stays inside at every extreme value.
    property <length> margin: 14px;
    // Height of the readout lines at the bottom.
    property <length> readouts-h: 34px;
    property <angle> alpha: 28deg;
    property <length> r0: 20px;
    // Room left of the apex for the speaker.
    property <length> speaker-w: 26px;
    property <length> rmax: min(
        self.width - 2 * self.margin - self.speaker-w,
        (self.height - self.readouts-h - 2 * self.margin) / 2 / sin(self.alpha));
    // Figure centred in the area above the readouts.
    property <length> ax: (self.width - self.speaker-w - self.rmax) / 2 + self.speaker-w;
    property <length> ay: (self.height - self.readouts-h) / 2;

    pure function theta(x: float) -> angle {
        return -root.alpha + x / 10 * 2 * root.alpha;
    }
    pure function radius(z: float) -> length {
        return root.r0 + z / 10 * (root.rmax - root.r0);
    }
    pure function px(x: float, z: float) -> length {
        return root.ax + root.radius(z) * cos(root.theta(x));
    }
    pure function py(x: float, z: float) -> length {
        return root.ay + root.radius(z) * sin(root.theta(x));
    }

    // Pointer position (pad coordinates) → mic position: polar around the
    // apex, clamped to the wedge, 0.1 steps; writes only what changed.
    function drag(mic: int, x: length, y: length) {
        let dx = (x - root.ax) / 1px;
        let dy = (y - root.ay) / 1px;
        let r = sqrt(dx * dx + dy * dy) * 1px;
        let u = clamp((atan2(dy, dx) + root.alpha) / (2 * root.alpha), 0, 1);
        let v = clamp((r - root.r0) / (root.rmax - root.r0), 0, 1);
        let nx = round(u * 100) / 10;
        let nz = round(v * 100) / 10;
        if (mic == 0) {
            if (nx != root.m1x) {
                root.m1x = nx;
                root.edited(0, nx);
            }
            if (nz != root.m1z) {
                root.m1z = nz;
                root.edited(1, nz);
            }
        } else {
            if (nx != root.m2x) {
                root.m2x = nx;
                root.edited(2, nx);
            }
            if (nz != root.m2z) {
                root.m2z = nz;
                root.edited(3, nz);
            }
        }
    }

    // Double-click on a dot: back to the preset's loaded position.
    function reset(mic: int) {
        if (mic == 0) {
            root.m1x = root.m1x-default;
            root.m1z = root.m1z-default;
            root.edited(0, root.m1x);
            root.edited(1, root.m1z);
        } else {
            root.m2x = root.m2x-default;
            root.m2z = root.m2z-default;
            root.edited(2, root.m2x);
            root.edited(3, root.m2z);
        }
    }

    // Wedge fill: 5 ring bands, amber fading with distance from the
    // speaker (stacked paths render the same in every renderer).
    for band in 5: Path {
        property <length> r-in: root.r0 + band / 5 * (root.rmax - root.r0);
        property <length> r-out: root.r0 + (band + 1) / 5 * (root.rmax - root.r0);
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        fill: Theme.accent.with-alpha([0.22, 0.16, 0.11, 0.07, 0.035][band]);
        MoveTo {
            x: (root.ax + r-in * cos(-root.alpha)) / 1px;
            y: (root.ay + r-in * sin(-root.alpha)) / 1px;
        }
        LineTo {
            x: (root.ax + r-out * cos(-root.alpha)) / 1px;
            y: (root.ay + r-out * sin(-root.alpha)) / 1px;
        }
        ArcTo {
            x: (root.ax + r-out * cos(root.alpha)) / 1px;
            y: (root.ay + r-out * sin(root.alpha)) / 1px;
            radius-x: r-out / 1px;
            radius-y: r-out / 1px;
            sweep: true;
        }
        LineTo {
            x: (root.ax + r-in * cos(root.alpha)) / 1px;
            y: (root.ay + r-in * sin(root.alpha)) / 1px;
        }
        ArcTo {
            x: (root.ax + r-in * cos(-root.alpha)) / 1px;
            y: (root.ay + r-in * sin(-root.alpha)) / 1px;
            radius-x: r-in / 1px;
            radius-y: r-in / 1px;
            sweep: false;
        }
        Close {}
    }

    // Faint rays and arcs (the "cheese" structure).
    for k in 3: Path {
        property <angle> a: -root.alpha + (k + 1) / 4 * 2 * root.alpha;
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: Theme.accent.with-alpha(0.14);
        stroke-width: 1px;
        MoveTo {
            x: (root.ax + root.r0 * cos(a)) / 1px;
            y: (root.ay + root.r0 * sin(a)) / 1px;
        }
        LineTo {
            x: (root.ax + root.rmax * cos(a)) / 1px;
            y: (root.ay + root.rmax * sin(a)) / 1px;
        }
    }
    for k in 2: Path {
        property <length> r: root.r0 + (k + 1) / 3 * (root.rmax - root.r0);
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: Theme.accent.with-alpha(0.14);
        stroke-width: 1px;
        MoveTo {
            x: (root.ax + r * cos(-root.alpha)) / 1px;
            y: (root.ay + r * sin(-root.alpha)) / 1px;
        }
        ArcTo {
            x: (root.ax + r * cos(root.alpha)) / 1px;
            y: (root.ay + r * sin(root.alpha)) / 1px;
            radius-x: r / 1px;
            radius-y: r / 1px;
            sweep: true;
        }
    }

    // Outline: the two straight edges and the far arc.
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: Theme.accent.with-alpha(0.4);
        stroke-width: 1px;
        MoveTo {
            x: (root.ax + root.r0 * cos(-root.alpha)) / 1px;
            y: (root.ay + root.r0 * sin(-root.alpha)) / 1px;
        }
        LineTo {
            x: (root.ax + root.rmax * cos(-root.alpha)) / 1px;
            y: (root.ay + root.rmax * sin(-root.alpha)) / 1px;
        }
        ArcTo {
            x: (root.ax + root.rmax * cos(root.alpha)) / 1px;
            y: (root.ay + root.rmax * sin(root.alpha)) / 1px;
            radius-x: root.rmax / 1px;
            radius-y: root.rmax / 1px;
            sweep: true;
        }
        LineTo {
            x: (root.ax + root.r0 * cos(root.alpha)) / 1px;
            y: (root.ay + root.r0 * sin(root.alpha)) / 1px;
        }
    }

    // Speaker at the apex: cone seen at an angle as concentric ellipses
    // (outer rim, cone, dust cap), muted strokes.
    for ring in 3: Path {
        property <length> rx: [7px, 5px, 2.5px][ring];
        property <length> ry: [24px, 16px, 7px][ring];
        // Cone face at the start of the wedge (radius r0).
        property <length> cx: root.ax + root.r0 - [12px, 10px, 8px][ring];
        width: 100%;
        height: 100%;
        viewbox-width: root.width / 1px;
        viewbox-height: root.height / 1px;
        stroke: ring == 2 ? Theme.muted : Theme.muted.with-alpha(0.7);
        stroke-width: 1px;
        fill: ring == 2 ? Theme.muted.with-alpha(0.25) : transparent;
        MoveTo {
            x: cx / 1px;
            y: (root.ay - ry) / 1px;
        }
        ArcTo {
            x: cx / 1px;
            y: (root.ay + ry) / 1px;
            radius-x: rx / 1px;
            radius-y: ry / 1px;
            sweep: true;
        }
        ArcTo {
            x: cx / 1px;
            y: (root.ay - ry) / 1px;
            radius-x: rx / 1px;
            radius-y: ry / 1px;
            sweep: true;
        }
        Close {}
    }

    // Mic 2 first, so Mic 1 is on top where they overlap.
    Rectangle {
        x: root.px(root.m2x, root.m2z) - 9px;
        y: root.py(root.m2x, root.m2z) - 9px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: Theme.mic2.with-alpha(0.2);
    }
    Rectangle {
        x: root.px(root.m2x, root.m2z) - 6px;
        y: root.py(root.m2x, root.m2z) - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.mic2;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 6px;
        drop-shadow-color: Theme.mic2.with-alpha(0.7);
    }
    TouchArea {
        x: root.px(root.m2x, root.m2z) - 12px;
        y: root.py(root.m2x, root.m2z) - 12px;
        width: 24px;
        height: 24px;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.move : MouseCursor.default;
        moved => {
            if (self.pressed) {
                root.drag(1, self.x + self.mouse-x, self.y + self.mouse-y);
            }
        }
        double-clicked => { root.reset(1); }
    }

    Rectangle {
        x: root.px(root.m1x, root.m1z) - 9px;
        y: root.py(root.m1x, root.m1z) - 9px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: Theme.accent.with-alpha(0.2);
    }
    Rectangle {
        x: root.px(root.m1x, root.m1z) - 6px;
        y: root.py(root.m1x, root.m1z) - 6px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: Theme.accent;
        border-width: 1px;
        border-color: Theme.edge;
        drop-shadow-blur: 6px;
        drop-shadow-color: Theme.accent.with-alpha(0.7);
    }
    TouchArea {
        x: root.px(root.m1x, root.m1z) - 12px;
        y: root.py(root.m1x, root.m1z) - 12px;
        width: 24px;
        height: 24px;
        enabled: root.enabled;
        mouse-cursor: root.enabled ? MouseCursor.move : MouseCursor.default;
        moved => {
            if (self.pressed) {
                root.drag(0, self.x + self.mouse-x, self.y + self.mouse-y);
            }
        }
        double-clicked => { root.reset(0); }
    }

    // Readouts, colour-coded per mic.
    Text {
        x: 4px;
        y: root.height - 28px;
        text: "MIC 1  X \{Format.one(root.m1x)}  Z \{Format.one(root.m1z)}";
        color: Theme.accent;
        font-size: 9px;
        font-family: Theme.mono-font;
        letter-spacing: 0.5px;
    }
    Text {
        x: 4px;
        y: root.height - 14px;
        text: "MIC 2  X \{Format.one(root.m2x)}  Z \{Format.one(root.m2z)}";
        color: Theme.mic2;
        font-size: 9px;
        font-family: Theme.mono-font;
        letter-spacing: 0.5px;
    }
}

// On/Off chip for an effect block header: green dot + "On", muted "Off".
component OnOffChip inherits Rectangle {
    in-out property <bool> on: true;
    callback toggled(bool);

    horizontal-stretch: 0;
    background: chip-ta.pressed ? Theme.selected : (chip-ta.has-hover ? Theme.hover : Theme.soft);
    border-radius: 6px;
    border-width: 1px;
    border-color: chip-ta.has-hover ? Theme.bevel : Theme.border;
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            // LED: green with glow when on, dark when off.
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.on ? Theme.ok : Theme.led-off;
                drop-shadow-blur: root.on ? 6px : 0px;
                drop-shadow-color: root.on ? Theme.ok.with-alpha(0.9) : transparent;
            }
        }
        Text {
            // Fixed slot ("OFF" is wider than "ON"), so the chip never
            // changes width and shoves its row neighbours.
            width: 22px;
            text: root.on ? "ON" : "OFF";
            color: chip-ta.has-hover ? Theme.hw-ink-hover : (root.on ? Theme.ink : Theme.status-ink);
            font-size: 10px;
            font-family: Theme.mono-font;
            letter-spacing: 1px;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
    }
    chip-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// Small two-state button whose caption names the current state
// ("Pre amp" / "Post amp"); highlighted when `on`.
// Latching hardware button: sunk with amber text when `on`.
component StateButton inherits HwButton {
    in-out property <bool> on;
    in property <string> on-text;
    in property <string> off-text;
    callback toggled(bool);

    height: 26px;
    min-width: 32px;
    horizontal-stretch: 1;
    checked: root.on;
    clicked => {
        root.on = !root.on;
        root.toggled(root.on);
    }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.on ? root.on-text : root.off-text;
        color: root.on ? Theme.accent : (root.hover ? Theme.hw-ink-hover : Theme.hw-ink);
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
}

// Window height, for popups deciding whether to open upward (kept in sync
// by AppWindow).
global WindowMetrics {
    in-out property <length> height: 610px;
}

// Compact selector: ‹ label › cycling through `options` (no wrap-around).
// Clicking the value opens a list of all options to pick from (e.g. the
// 64 VIR cab models); it opens upward when there's no room below.
// The value slot has a fixed width (`value-width`, sized per instance to the
// longest option; mono 10px = 6px per character), so the stepper never
// changes width with its value.
component Stepper inherits Rectangle {
    in property <[string]> options;
    in-out property <int> index;
    // false: shown dimmed, arrows inactive.
    in property <bool> enabled: true;
    in property <length> value-width: 56px;
    // Value text colour (the cab mic steppers use their pad dot colours).
    in property <color> value-color: Theme.ink;
    // Optional longer names for the dropdown rows (same order as
    // `options`); the compact `options` stay in the value slot.
    in property <[string]> list-options: [];
    callback picked(int);

    // Option list popup: up to 8 rows, scrolls beyond.
    property <length> row-h: 24px;
    property <length> list-h: min(root.options.length, 8) * self.row-h + 8px;
    property <length> list-w: max(root.width, 124px);
    property <bool> open-up: root.absolute-position.y + root.height + 2px + self.list-h > WindowMetrics.height - 6px;

    opacity: root.enabled ? 1 : 0.45;

    height: 26px;
    min-width: 44px + root.value-width;
    max-width: 44px + root.value-width;
    horizontal-stretch: 0;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.field;

    HorizontalLayout {
        prev := Rectangle {
            width: 22px;
            border-radius: 7px;
            background: prev-ta.has-hover && root.index > 0 ? Theme.hover : transparent;
            Text {
                text: "‹";
                color: root.index > 0 ? Theme.ink : Theme.muted.with-alpha(0.4);
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            prev-ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.index > 0 ? pointer : default;
                clicked => {
                    if (root.index > 0) {
                        root.index -= 1;
                        root.picked(root.index);
                    }
                }
            }
        }
        // Value: click for the option list.
        Rectangle {
            width: root.value-width;
            border-radius: 4px;
            background: value-ta.has-hover && value-ta.enabled ? Theme.hover.with-alpha(0.6) : transparent;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.index >= 0 && root.index < root.options.length ? root.options[root.index] : "?";
                color: root.value-color;
                font-size: 10px;
                font-family: Theme.mono-font;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
            value-ta := TouchArea {
                enabled: root.enabled && root.options.length > 1;
                mouse-cursor: self.enabled ? pointer : default;
                clicked => {
                    popup.show();
                }
            }
        }
        Rectangle {
            width: 22px;
            border-radius: 7px;
            background: next-ta.has-hover && root.index < root.options.length - 1 ? Theme.hover : transparent;
            Text {
                text: "›";
                color: root.index < root.options.length - 1 ? Theme.ink : Theme.muted.with-alpha(0.4);
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            next-ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.index < root.options.length - 1 ? pointer : default;
                clicked => {
                    if (root.index < root.options.length - 1) {
                        root.index += 1;
                        root.picked(root.index);
                    }
                }
            }
        }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.open-up ? -root.list-h - 2px : root.height + 2px;
        width: root.list-w;
        height: root.list-h;
        // Scrolling the list must not close it; a pick closes it below.
        close-policy: PopupClosePolicy.close-on-click-outside;

        Rectangle {
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.edge;
            border-radius: 8px;
            drop-shadow-blur: 12px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: #000000aa;

            ListView {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;

                // The popup's content is created on each show: bring the
                // current option to the middle.
                init => {
                    let total = root.options.length * root.row-h;
                    let visible = root.list-h - 8px;
                    let target = root.index * root.row-h - (visible - root.row-h) / 2;
                    self.content-y = -clamp(target, 0px, max(0px, total - visible));
                }

                for option[i] in root.list-options.length == root.options.length ? root.list-options : root.options: Rectangle {
                    height: root.row-h;
                    property <bool> current: i == root.index;

                    Rectangle {
                        y: 1px;
                        width: parent.width;
                        height: root.row-h - 2px;
                        border-radius: 5px;
                        border-width: 1px;
                        border-color: current ? Theme.bevel : transparent;
                        background: current ? Theme.selected : (option-ta.has-hover ? Theme.soft : transparent);

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            Text {
                                horizontal-stretch: 1;
                                text: option;
                                color: current ? Theme.accent : Theme.secondary-ink;
                                font-size: 10px;
                                font-family: Theme.mono-font;
                                vertical-alignment: center;
                                overflow: elide;
                                wrap: no-wrap;
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 5px;
                                    height: 5px;
                                    border-radius: 2.5px;
                                    background: current ? Theme.accent : Theme.led-off;
                                }
                            }
                        }

                        option-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                // Same as the arrows: `picked` (and its
                                // write) only on a real change.
                                if (i != root.index) {
                                    root.index = i;
                                    root.picked(i);
                                }
                                popup.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "TX Open Studio";
    icon: @image-url("../assets/icon.png");
    preferred-width: 560px;
    preferred-height: 610px;
    min-width: 540px;
    background: Theme.page;

    in-out property <int> preset: 43;
    in property <string> preset-name;
    // Character of the current preset ("" = unknown → no badge) and its
    // colour group (see PresetRow.kind).
    in property <string> preset-character;
    in property <int> preset-character-kind;
    // 150 list rows: bank number, character badge, name (empty until names load).
    in property <[PresetRow]> preset-names;
    in property <bool> connected: false;
    // A link is down and the app is polling for the pedal (amber LED).
    in property <bool> reconnecting: false;
    // The pedal's serial port may not be opened (udev rule missing):
    // steady red LED, the status text explains.
    in property <bool> no-access: false;
    // Newer release found ("v1.2.3"; "" = none): amber chip in the status
    // bar that opens the releases page.
    in property <string> update-version;
    callback open-releases();
    in property <string> status-text: "RECONNECTING…";
    // Step blink of the amber LED (0.5 s), only while reconnecting.
    property <bool> led-dim: false;
    // Connected MIDI output port ("" when disconnected), shown in the status bar.
    // Current preset modified since it was loaded (set/cleared from Rust).
    in property <bool> preset-dirty: false;

    // Amp knobs, 0..10. Set from Rust when read from the pedal.
    in-out property <float> amp-gain: 5;
    in-out property <float> amp-volume: 5;
    in-out property <float> amp-presence: 5;
    in-out property <float> amp-depth: 5;
    in-out property <float> amp-bass: 5;
    in-out property <float> amp-mid: 5;
    in-out property <float> amp-treble: 5;
    in-out property <bool> amp-enabled: true;
    // EQ band frequencies (Hz) of the current preset; locked until read
    // (eq-freq-known). Double-click resets to the values the preset was
    // loaded with (*-default; initial values: a hardware dump).
    in-out property <float> eq-bass-freq: 300;
    in-out property <float> eq-mid-freq: 750;
    in-out property <float> eq-treble-freq: 2000;
    in property <float> eq-bass-freq-default: 300;
    in property <float> eq-mid-freq-default: 750;
    in property <float> eq-treble-freq-default: 2000;
    in property <bool> eq-freq-known: false;
    // Amp model mix (0..100 %), same rules as the EQ frequencies.
    in-out property <float> amp-mix: 100;
    in property <float> amp-mix-default: 100;
    in property <bool> amp-mix-known: false;
    // EQ mid Q (0.20..3.00) and EQ position (false pre / true post), same
    // rules as the EQ frequencies (fx ids 64, 65).
    in-out property <float> eq-mid-q: 0.7;
    in property <float> eq-mid-q-default: 0.7;
    in property <bool> eq-mid-q-known: false;
    in-out property <bool> eq-post: false;
    in property <bool> eq-post-known: false;
    // True while any amp knob is being dragged (Rust skips pedal updates then).
    out property <bool> knob-active: k-gain.active || k-volume.active || k-presence.active
        || k-depth.active || k-bass.active || k-mid.active || k-treble.active;

    callback preset-changed(int);
    callback reconnect();
    // User turned an amp knob. id: 0 gain, 1 volume, 2 presence, 3 depth,
    // 4 bass, 5 mid, 6 treble (matches AmpParam in main.rs).
    callback amp-param-changed(int, float);
    // User toggled the amp on/off chip.
    callback amp-enable-changed(bool);

    // Delay / Reverb blocks (values in pedal units; switches as bool,
    // selectors as option index). Set from Rust from the pedal's state.
    in-out property <bool> dly-enabled: false;
    in-out property <bool> dly-post: false;
    in-out property <int> dly-model: 0;
    in-out property <bool> dly-sync: false;
    in-out property <int> dly-division: 9;
    in-out property <float> dly-time: 320;
    in-out property <float> dly-feedback: 0;
    in-out property <bool> dly-pingpong: false;
    in-out property <float> dly-mix: 0;
    in-out property <bool> rvb-enabled: false;
    in-out property <bool> rvb-post: false;
    in-out property <int> rvb-model: 5;
    in-out property <float> rvb-time: 5;
    in-out property <float> rvb-predelay: 0;
    in-out property <float> rvb-color: 0;
    in-out property <float> rvb-mix: 0;
    // Pedal's time-signature list (index = value sent to the pedal).
    out property <[string]> delay-divisions: ["1/32", "1/32 D", "1/32 T", "1/16", "1/16 D", "1/16 T", "1/8", "1/8 D", "1/8 T",
        "1/4", "1/4 D", "1/4 T", "1/2", "1/2 D", "1/2 T", "1/1", "1/1 D", "1/1 T"];
    // User changed an effect control. id (matches FxControl in fx.rs):
    // 0 dly on, 1 dly post, 2 dly model, 3 dly sync, 4 dly division,
    // 5 dly time, 6 dly feedback, 7 dly ping-pong, 8 dly mix,
    // 10 rvb on, 11 rvb post, 12 rvb model, 13 rvb time, 14 rvb predelay,
    // 15 rvb color, 16 rvb mix,
    // 20 comp on, 21 comp post, 22 comp threshold, 23 comp gain, 24 comp attack,
    // 30 mod on, 31 mod post, 32 mod model, 33 mod sync, 34 mod division,
    // 35..38 mod knobs 1..4 of the selected type,
    // 60 EQ bass freq, 61 EQ mid freq, 62 EQ treble freq (Hz, serial only),
    // 63 amp mix (%, serial only).
    callback fx-changed(int, float);

    // Compressor / Modulation (pedal units; see fx.rs).
    in-out property <bool> comp-enabled: false;
    in-out property <bool> comp-post: true;
    in-out property <float> comp-threshold: -14;
    in-out property <float> comp-gain: -12;
    in-out property <float> comp-attack: 14;
    in-out property <bool> mod-enabled: false;
    in-out property <bool> mod-post: false;
    in-out property <int> mod-model: 0;
    in-out property <bool> mod-sync: false;
    in-out property <int> mod-division: 9;
    in-out property <float> mod-k1: 0.5;
    in-out property <float> mod-k2: 0;
    in-out property <float> mod-k3: 5;
    in-out property <float> mod-k4: 5;

    // Noise Gate / Cabinet (pedal units; see fx.rs). fx-changed ids:
    // 40 gate on, 41 gate post, 42 threshold, 43 release, 44 depth,
    // 50 cab type, 51 VIR cab model, 52 reso, 53 mic 1, 54 mic 1 X,
    // 55 mic 1 Z, 56 mic 2, 57 mic 2 X, 58 mic 2 Z, 59 blend.
    in-out property <bool> gate-enabled: true;
    in-out property <bool> gate-post: false;
    in-out property <float> gate-threshold: -64;
    in-out property <float> gate-release: 20;
    in-out property <float> gate-depth: -60;
    // 0 Tone Model, 1 VIR, 2 Off.
    in-out property <int> cab-type: 0;
    in-out property <int> cab-model: 0;
    // VIR cab model names (fx::cab_model_options, set from Rust).
    in property <[string]> cab-model-names;
    in-out property <int> cab-mic1: 0;
    in-out property <int> cab-mic2: 0;
    in-out property <float> cab-reso: 0;
    in-out property <float> cab-mic1-x: 0;
    in-out property <float> cab-mic1-z: 0;
    in-out property <float> cab-mic2-x: 0;
    in-out property <float> cab-mic2-z: 0;
    in-out property <float> cab-blend: 0;
    // Mic positions as the preset was loaded (mic pad double-click reset).
    in property <float> cab-mic1-x-default: 0;
    in property <float> cab-mic1-z-default: 0;
    in property <float> cab-mic2-x-default: 0;
    in property <float> cab-mic2-z-default: 0;
    // Chip state derived from cab-type, and the type to restore when the
    // chip turns the cabinet back on.
    property <bool> cab-on: true;
    property <int> cab-last-on: 0;
    changed cab-type => {
        root.cab-on = root.cab-type != 2;
        if (root.cab-type != 2) {
            root.cab-last-on = root.cab-type;
        }
    }

    // Global (pedal-wide) settings, all written by patching the global
    // config (see GLOBAL_CONTROLS in main.rs). global-changed ids:
    // 0 input trim, 1 master, 2 interface volume (dB), 3 tuner mode,
    // 4 tuner ref (Hz), 5 tempo (BPM), 6 tempo mode, 7 cab sim, 8 MIDI
    // channel (1..16), 9 MIDI thru, 10 MIDI clock, 11 naming. Locked until
    // the first globals read (globals-known).
    in property <bool> globals-known: false;
    in-out property <float> global-interface: -10;
    in-out property <int> tuner-mode: 0;
    in-out property <float> tuner-ref: 440;
    in-out property <float> tempo-bpm: 120;
    in-out property <int> tempo-mode: 0;
    in-out property <bool> cab-sim: true;
    in-out property <int> midi-channel-index: 0;
    in-out property <bool> midi-thru: false;
    in-out property <int> midi-clock: 0;
    // Also drives this app's preset ids (list and OLED); Bank+Name until
    // the globals are read.
    in-out property <int> naming: 2;
    in-out property <float> global-trim: 0;
    // Current preset's volume (0..10) and whether it has been read.
    in-out property <float> preset-level: 5;
    in property <bool> preset-level-known: false;
    callback preset-level-changed(float);
    in-out property <float> global-volume: 0;
    // Tuner on/off as last set by the app (the pedal doesn't report it).
    in-out property <bool> tuner-active: false;
    // Tap tempo: one CC10 per tap (Rust); readout estimated from the taps.
    callback tap-tempo();
    // Selected deck tab (UI only): 0 PRESETS, 1 GLOBAL, 2 GATE, 3 COMP,
    // 4 AMP, 5 CAB, 6 MOD, 7 DELAY, 8 REVERB.
    in-out property <int> tab: 0;
    callback tuner-toggled(bool);
    callback global-changed(int, float);

    // Preset list search: Rust filters `preset-names` and reports the match
    // count and the current preset's row (-1 = filtered out).
    callback search-changed(string);
    // Preset rename (list context menu): row being edited and rename in
    // flight (preset numbers, 0 = none). rename-preset writes to the pedal
    // (Rust); name-filter keeps the field to printable ASCII, 32 bytes.
    in-out property <int> rename-edit: 0;
    in property <int> rename-busy: 0;
    callback rename-preset(int, string);
    pure callback name-filter(string) -> string;
    // Short status bar message (e.g. "RENAME FAILED"), cleared after 4 s.
    in-out property <string> status-note;
    in property <int> preset-count: 150;
    in property <int> selected-row: -1;
    // Keyboard-highlighted list row (-1 = none).
    property <int> cursor-row: -1;
    // Brief pressed look on PREV (-1) / NEXT (1) after an arrow key, TAP (2)
    // after the T key.
    property <int> flash: 0;

    changed preset => {
        list.ensure-selected-visible();
    }
    init => {
        WindowMetrics.height = self.height;
    }
    changed height => {
        WindowMetrics.height = self.height;
    }
    changed selected-row => {
        list.ensure-selected-visible();
    }

    // Previous/next preset with wrap-around (1 <-> 150).
    function step-preset(dir: int) {
        root.preset-changed(dir < 0
            ? (root.preset <= 1 ? 150 : root.preset - 1)
            : (root.preset >= 150 ? 1 : root.preset + 1));
    }
    // Left/Right arrow keys: like PREV/NEXT, with a short press flash.
    function key-step(dir: int) {
        root.flash = dir;
        root.step-preset(dir);
    }
    function select-tab(n: int) {
        root.tab = n;
        root.rename-edit = 0;
        main-keys.focus();
    }

    Timer {
        interval: 4s;
        running: root.status-note != "";
        triggered => {
            root.status-note = "";
        }
    }

    Timer {
        interval: 500ms;
        running: root.reconnecting && !root.connected;
        triggered => {
            root.led-dim = !root.led-dim;
        }
    }

    Timer {
        interval: 110ms;
        running: root.flash != 0;
        triggered => {
            root.flash = 0;
        }
    }

    // Window-wide keys while neither the search field nor the list has
    // focus (it gets focus at start, on Escape, and when clicking empty
    // space or tabs/stage buttons).
    forward-focus: main-keys;
    main-keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.LeftArrow) {
                root.key-step(-1);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.key-step(1);
                return accept;
            }
            // T = tap tempo; held-key repeats would fake fast taps.
            if ((event.text == "t" || event.text == "T") && !event.modifiers.control && !event.modifiers.alt) {
                if (!event.repeat) {
                    root.flash = 2;
                    root.tap-tempo();
                }
                return accept;
            }
            reject
        }
    }

    // Chassis: rounded body with near-black edge and an inner bevel ring
    // plus a brighter top line, inset from the window by a page margin.
    property <length> margin: 10px;
    Rectangle {
        x: root.margin;
        y: root.margin;
        width: parent.width - 2 * root.margin;
        height: parent.height - 2 * root.margin;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.edge;
        background: @linear-gradient(180deg, Theme.body-top 0%, Theme.body 38%, Theme.body-bottom 100%);

        Rectangle {
            x: 1px;
            y: 1px;
            width: parent.width - 2px;
            height: parent.height - 2px;
            border-radius: 11px;
            border-width: 1px;
            border-color: Theme.bevel.with-alpha(0.5);
        }
        Rectangle {
            x: 10px;
            y: 1px;
            width: parent.width - 20px;
            height: 1px;
            background: Theme.bevel;
        }
    }

    // Content sits inside the chassis border.
    VerticalLayout {
        padding: root.margin + 1px;
        spacing: 0px;

        // Brand row: amber mark + name left; model label and the tuner
        // button right.
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 12px;
            spacing: 8px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 2px;
                    background: Theme.accent;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: Theme.accent.with-alpha(0.6);
                }
            }
            Text {
                horizontal-stretch: 1;
                text: "TX OPEN STUDIO";
                color: Theme.hw-ink;
                font-size: 11px;
                font-weight: 600;
                letter-spacing: 2px;
                vertical-alignment: center;
            }
            // Tuner on/off (MIDI CC9). The pedal reports no tuner state, so
            // this shows what the app set; the OLED label reads TUNER ON.
            tuner-btn := HwButton {
                width: 26px;
                height: 26px;
                radius: 5px;
                checked: root.tuner-active;
                clicked => {
                    root.tuner-active = !root.tuner-active;
                    root.tuner-toggled(root.tuner-active);
                }

                Image {
                    source: @image-url("../assets/tuner.png");
                    width: 14px;
                    height: 14px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    colorize: root.tuner-active ? Theme.accent
                        : (tuner-btn.hover ? Theme.hw-ink-hover : Theme.hw-ink);
                }
                // Amber LED, top-right, while the tuner is on.
                if root.tuner-active: Rectangle {
                    x: parent.width - 7px;
                    y: 3px;
                    width: 4px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.accent;
                    drop-shadow-blur: 5px;
                    drop-shadow-color: Theme.accent.with-alpha(0.9);
                }
            }
        }

        // Controller deck: stage, tab row, tray.
        VerticalLayout {
            vertical-stretch: 1;
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 14px;
            padding-bottom: 12px;
            spacing: 10px;

            // Stage: PREV | OLED display | NEXT (wraps 1 ↔ 150).
            HorizontalLayout {
                vertical-stretch: 0;
                height: 116px;
                spacing: 8px;

                prev-btn := HwButton {
                    width: 56px;
                    checked: root.flash == -1;
                    clicked => {
                        root.step-preset(-1);
                        main-keys.focus();
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "‹";
                            color: prev-btn.hover ? Theme.hw-ink-hover : Theme.hw-ink;
                            font-size: 24px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "PREV";
                            color: prev-btn.hover ? Theme.hw-ink-hover : Theme.hw-ink;
                            font-size: 9px;
                            font-weight: 600;
                            font-family: Theme.mono-font;
                            letter-spacing: 1.5px;
                            horizontal-alignment: center;
                        }
                    }
                }

                // OLED display. Bank/slot in pedal terms: 0-based bank
                // (0..49, as in the preset list) plus slot letter.
                oled := Rectangle {
                    horizontal-stretch: 1;
                    min-width: 0px;
                    background: Theme.oled;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: Theme.oled-edge;
                    clip: true;

                    property <int> bank: floor((root.preset - 1) / 3);
                    property <string> slot: ["A", "B", "C"][mod(root.preset - 1, 3)];

                    // Inset shadow illusion along the top edge.
                    Rectangle {
                        y: 0px;
                        height: 14px;
                        background: @linear-gradient(180deg, #000000e6 0%, #00000000 100%);
                    }

                    HorizontalLayout {
                        padding-left: 18px;
                        padding-right: 12px;
                        spacing: 12px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            alignment: center;
                            // Three lines in Name mode get more air.
                            spacing: root.naming == 0 ? 10px : 7px;

                            // "● ACTIVE PRESET" (green) / "● TUNER ON" (amber).
                            HorizontalLayout {
                                spacing: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 5px;
                                        height: 5px;
                                        border-radius: 2.5px;
                                        background: root.tuner-active ? Theme.accent : Theme.ok;
                                        drop-shadow-blur: 6px;
                                        drop-shadow-color: (root.tuner-active ? Theme.accent : Theme.ok).with-alpha(0.9);
                                    }
                                }
                                Text {
                                    horizontal-stretch: 1;
                                    text: root.tuner-active ? "TUNER ON" : "ACTIVE PRESET";
                                    color: root.tuner-active ? Theme.accent : Theme.muted;
                                    font-size: 9px;
                                    font-weight: 500;
                                    font-family: Theme.mono-font;
                                    letter-spacing: 1.5px;
                                    vertical-alignment: center;
                                }
                            }

                            // Name first: the primary info. Read over USB
                            // serial; muted placeholder (no glow) until
                            // names are loaded.
                            GlowText {
                                text: root.preset-name == "" ? "Preset \{root.preset}" : root.preset-name;
                                ink: root.preset-name == "" ? Theme.muted : Theme.oled-ink;
                                // The strong amber wash stays in the OLED's upper
                                // zone (it followed the bank line down after the
                                // line swap; the user wants it back on top).
                                glow: Theme.accent;
                                glow-alpha: root.preset-name == "" ? 0 : 0.20;
                                font-size: 20px;
                                font-weight: root.preset-name == "" ? 400 : 600;
                            }

                            // Below it, per the pedal's Naming global: bank +
                            // slot or program number; no line at all in Name
                            // mode.
                            if root.naming != 0: GlowText {
                                text: root.naming == 2 ? "BANK \{oled.bank < 10 ? "0" : ""}\{oled.bank} • SLOT \{oled.slot}"
                                    : "PC \{Format.ordinal(root.preset)}";
                                ink: Theme.accent;
                                glow: Theme.oled-glow;
                                glow-alpha: 0.10;
                                font-size: 15px;
                                font-weight: 600;
                                font-family: Theme.mono-font;
                                letter-spacing: 1.8px;
                            }

                            // Character (gray TONE when the preset names
                            // none) + EDITED; fixed height so the display
                            // doesn't jump when chips come and go.
                            HorizontalLayout {
                                height: 16px;
                                alignment: start;
                                spacing: 5px;
                                if root.preset-name != "": OledChip {
                                    text: root.preset-character-kind > 0 ? root.preset-character : "TONE";
                                    tint: CharacterColors.of(root.preset-character-kind);
                                }
                                if root.preset-dirty: OledChip {
                                    text: "EDITED";
                                    tint: Theme.changed;
                                    solid: true;
                                }
                            }
                        }
                    }

                    // Diagonal glass sheen (no input, so clicks pass through).
                    Rectangle {
                        background: @linear-gradient(115deg, #ffffff12 0%, #ffffff04 30%, #ffffff00 30.2%);
                    }
                }

                next-btn := HwButton {
                    width: 56px;
                    checked: root.flash == 1;
                    clicked => {
                        root.step-preset(1);
                        main-keys.focus();
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text {
                            text: "›";
                            color: next-btn.hover ? Theme.hw-ink-hover : Theme.hw-ink;
                            font-size: 24px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "NEXT";
                            color: next-btn.hover ? Theme.hw-ink-hover : Theme.hw-ink;
                            font-size: 9px;
                            font-weight: 600;
                            font-family: Theme.mono-font;
                            letter-spacing: 1.5px;
                            horizontal-alignment: center;
                        }
                    }
                }
            }

            // Tab row: 9 equal hardware tabs; module tabs carry an LED with
            // the module's on/off state.
            HorizontalLayout {
                vertical-stretch: 0;
                spacing: 3px;
                TabButton { label: "PRESETS"; selected: root.tab == 0; clicked => { root.select-tab(0); } }
                TabButton { label: "GLOBAL"; selected: root.tab == 1; clicked => { root.select-tab(1); } }
                TabButton { label: "GATE"; has-led: true; led-on: root.gate-enabled; selected: root.tab == 2; clicked => { root.select-tab(2); } }
                TabButton { label: "COMP"; has-led: true; led-on: root.comp-enabled; selected: root.tab == 3; clicked => { root.select-tab(3); } }
                TabButton { label: "AMP"; has-led: true; led-on: root.amp-enabled; selected: root.tab == 4; clicked => { root.select-tab(4); } }
                TabButton { label: "CAB"; has-led: true; led-on: root.cab-on; selected: root.tab == 5; clicked => { root.select-tab(5); } }
                TabButton { label: "MOD"; has-led: true; led-on: root.mod-enabled; selected: root.tab == 6; clicked => { root.select-tab(6); } }
                TabButton { label: "DELAY"; has-led: true; led-on: root.dly-enabled; selected: root.tab == 7; clicked => { root.select-tab(7); } }
                TabButton { label: "REVERB"; has-led: true; led-on: root.rvb-enabled; selected: root.tab == 8; clicked => { root.select-tab(8); } }
            }

            // Tray: one inset panel showing the selected tab's page. All
            // pages exist at once and are switched with `visible`, so their
            // bindings stay alive; the tray's size never depends on the page.
            tray := Rectangle {
                vertical-stretch: 1;
                min-height: 320px;
                preferred-height: 320px;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.edge;
                border-radius: 8px;
                clip: true;

                property <length> pad: 10px;
                // Knob slot: a quarter of the inner width (4 knobs per row).
                property <length> slot: (self.width - 2 * self.pad) / 4;
                // Five knobs per row (AMP row 1).
                property <length> slot5: (self.width - 2 * self.pad) / 5;

                // Inset shadow illusion along the top edge.
                Rectangle {
                    y: 0px;
                    height: 10px;
                    background: @linear-gradient(180deg, #000000b3 0%, #00000000 100%);
                }

                // PRESETS: search field above the (filtered) preset list.
                Rectangle {
                    x: tray.pad;
                    y: tray.pad;
                    width: parent.width - 2 * tray.pad;
                    height: parent.height - 2 * tray.pad;
                    visible: root.tab == 0;

                    VerticalLayout {
                        spacing: 6px;

                        // Search: filtering happens in Rust (search-changed).
                        Rectangle {
                            height: 26px;
                            background: Theme.oled;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: search-input.has-focus ? Theme.accent.with-alpha(0.6) : Theme.border;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;

                                // Magnifier glyph.
                                VerticalLayout {
                                    alignment: center;
                                    Path {
                                        width: 12px;
                                        height: 12px;
                                        viewbox-width: 24;
                                        viewbox-height: 24;
                                        stroke: Theme.muted;
                                        stroke-width: 1.6px;
                                        commands: "M 18 11 A 7 7 0 1 1 4 11 A 7 7 0 1 1 18 11 M 20 20 L 16 16";
                                    }
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    clip: true;

                                    // Placeholder (TextInput has none).
                                    Text {
                                        x: 0px;
                                        width: parent.width;
                                        height: parent.height;
                                        horizontal-alignment: left;
                                        visible: search-input.text == "";
                                        text: "Search name, bank or tag";
                                        color: Theme.muted;
                                        font-size: 11px;
                                        font-weight: 500;
                                        font-family: Theme.mono-font;
                                        letter-spacing: 0.4px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }
                                    // Enter: pick the first match; Down: into
                                    // the list; Escape: clear (when already
                                    // empty, hand keys back to the window).
                                    // Left/Right move the text cursor and never
                                    // reach the window's preset keys.
                                    search-input := TextInput {
                                        x: 0px;
                                        width: parent.width;
                                        height: parent.height;
                                        horizontal-alignment: left;
                                        color: Theme.ink;
                                        font-size: 11px;
                                        font-weight: 500;
                                        font-family: Theme.mono-font;
                                        letter-spacing: 0.4px;
                                        vertical-alignment: center;
                                        single-line: true;
                                        selection-background-color: Theme.amber-glow;
                                        edited => {
                                            root.cursor-row = -1;
                                            root.search-changed(self.text);
                                        }
                                        accepted => {
                                            if (root.preset-names.length > 0) {
                                                root.preset-changed(root.preset-names[0].preset);
                                            }
                                        }
                                        key-pressed(event) => {
                                            if (event.text == Key.DownArrow) {
                                                if (root.preset-names.length > 0) {
                                                    root.cursor-row = 0;
                                                    list.ensure-row-visible(0);
                                                    list-keys.focus();
                                                }
                                                return accept;
                                            }
                                            if (event.text == Key.Escape) {
                                                if (self.text == "") {
                                                    main-keys.focus();
                                                } else {
                                                    self.text = "";
                                                    root.cursor-row = -1;
                                                    root.search-changed("");
                                                }
                                                return accept;
                                            }
                                            reject
                                        }
                                    }
                                }

                                Text {
                                    text: "\{root.preset-count} / 150";
                                    color: Theme.muted;
                                    font-size: 9px;
                                    font-weight: 500;
                                    font-family: Theme.mono-font;
                                    letter-spacing: 1px;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                }
                            }
                        }

                        // List keys: Up/Down move the highlighted row (Up past
                        // the first row returns to the search field), Enter
                        // selects it, Left/Right switch presets as elsewhere.
                        list-keys := FocusScope {
                            vertical-stretch: 1;
                            key-pressed(event) => {
                                let n = root.preset-names.length;
                                let at = root.cursor-row >= 0 ? root.cursor-row : root.selected-row;
                                if (event.text == Key.DownArrow) {
                                    if (n > 0) {
                                        root.cursor-row = at < 0 ? 0 : min(at + 1, n - 1);
                                        list.ensure-row-visible(root.cursor-row);
                                    }
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    if (at <= 0) {
                                        root.cursor-row = -1;
                                        search-input.focus();
                                    } else {
                                        root.cursor-row = at - 1;
                                        list.ensure-row-visible(root.cursor-row);
                                    }
                                    return accept;
                                }
                                if (event.text == Key.Return) {
                                    if (root.cursor-row >= 0 && root.cursor-row < n) {
                                        root.preset-changed(root.preset-names[root.cursor-row].preset);
                                    }
                                    return accept;
                                }
                                if (event.text == Key.LeftArrow || event.text == Key.RightArrow) {
                                    root.key-step(event.text == Key.LeftArrow ? -1 : 1);
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.cursor-row = -1;
                                    main-keys.focus();
                                    return accept;
                                }
                                reject
                            }

                            list := ListView {
                                width: parent.width;
                                height: parent.height;

                                property <length> row-height: 26px;
                                property <bool> initial-scroll-done: false;

                                // Scrolls only when `row` is (partly) out of
                                // view, then centers it. Clicking a visible row
                                // never moves the list.
                                function ensure-row-visible(row: int) {
                                    if (self.visible-height <= 0px || row < 0) {
                                        return;
                                    }
                                    let top = row * self.row-height;
                                    let bottom = top + self.row-height;
                                    if (top >= -self.content-y && bottom <= -self.content-y + self.visible-height) {
                                        return;
                                    }
                                    let max-scroll = max(0px, self.content-height - self.visible-height);
                                    let target = top - (self.visible-height - self.row-height) / 2;
                                    self.content-y = -clamp(target, 0px, max-scroll);
                                }

                                // Current preset's row; nothing when it is
                                // filtered out (selected-row -1).
                                function ensure-selected-visible() {
                                    self.ensure-row-visible(root.selected-row);
                                }

                                changed visible-height => {
                                    // First real layout pass: bring the startup preset into view.
                                    if (!self.initial-scroll-done && self.visible-height > 0px) {
                                        self.initial-scroll-done = true;
                                        self.ensure-selected-visible();
                                    }
                                }

                                // id · name · character tag · LED. Selection is
                                // by preset number (rows are filtered).
                                for row[index] in root.preset-names: Rectangle {
                                    height: list.row-height;

                                    property <bool> is-selected: root.preset == row.preset;
                                    property <bool> is-cursor: list-keys.has-focus && root.cursor-row == index;
                                    property <bool> editing: root.rename-edit == row.preset;
                                    property <bool> saving: root.rename-busy == row.preset;

                                    Rectangle {
                                        y: 1px;
                                        width: parent.width;
                                        height: 24px;
                                        border-radius: 5px;
                                        border-width: 1px;
                                        border-color: is-cursor ? Theme.accent.with-alpha(0.5) : (is-selected ? Theme.bevel : transparent);
                                        background: is-selected ? Theme.selected : (row-ta.has-hover || is-cursor ? Theme.soft : transparent);
                                        opacity: saving ? 0.5 : 1;

                                        // Context menu position (right-click).
                                        property <length> menu-x;
                                        property <length> menu-y;

                                        if !editing: HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 10px;

                                            // Id per the pedal's Naming global:
                                            // "41B" (Bank+Name), "125" (PC+Name),
                                            // none (Name).
                                            if root.naming != 0: Text {
                                                width: 26px;
                                                text: root.naming == 1 ? Format.ordinal(row.preset) : row.id;
                                                color: is-selected ? Theme.accent : Theme.muted;
                                                font-size: 11px;
                                                font-weight: 600;
                                                font-family: Theme.mono-font;
                                                vertical-alignment: center;
                                                wrap: no-wrap;
                                            }
                                            // Muted placeholder until names load.
                                            Text {
                                                horizontal-stretch: 1;
                                                min-width: 0px;
                                                text: row.name == "" ? "Preset \{row.preset}" : row.name;
                                                color: row.name == "" ? Theme.muted : Theme.secondary-ink;
                                                font-size: 12px;
                                                font-weight: row.name == "" ? 400 : 500;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                wrap: no-wrap;
                                            }
                                            if saving: Text {
                                                text: "saving…";
                                                color: Theme.muted;
                                                font-size: 9px;
                                                font-family: Theme.mono-font;
                                                vertical-alignment: center;
                                            }
                                            // Character tag in its colour; gray
                                            // TONE when the metadata names none.
                                            if row.name != "" && !saving: Text {
                                                text: row.kind > 0 ? row.character : "TONE";
                                                color: row.kind > 0 ? CharacterColors.of(row.kind).brighter(0.35) : Theme.muted;
                                                font-size: 9px;
                                                font-weight: 500;
                                                font-family: Theme.mono-font;
                                                letter-spacing: 0.4px;
                                                vertical-alignment: center;
                                                wrap: no-wrap;
                                            }
                                            VerticalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    width: 5px;
                                                    height: 5px;
                                                    border-radius: 2.5px;
                                                    background: is-selected ? Theme.accent : Theme.led-off;
                                                    drop-shadow-blur: is-selected ? 6px : 0px;
                                                    drop-shadow-color: is-selected ? Theme.accent.with-alpha(0.9) : transparent;
                                                }
                                            }
                                        }

                                        // Inline rename editor: name field, ✓ and ✕.
                                        // Enter confirms, Escape cancels.
                                        if editing: HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 4px;
                                            padding-top: 2px;
                                            padding-bottom: 2px;
                                            spacing: 4px;
                                            Rectangle {
                                                horizontal-stretch: 1;
                                                background: Theme.oled;
                                                border-radius: 4px;
                                                border-width: 1px;
                                                border-color: Theme.accent.with-alpha(0.6);
                                                clip: true;
                                                rename-input := TextInput {
                                                    x: 6px;
                                                    width: parent.width - 12px;
                                                    height: parent.height;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: left;
                                                    single-line: true;
                                                    color: Theme.ink;
                                                    font-size: 12px;
                                                    selection-background-color: Theme.amber-glow;
                                                    init => {
                                                        self.text = row.name;
                                                        self.focus();
                                                        self.select-all();
                                                    }
                                                    edited => {
                                                        let filtered = root.name-filter(self.text);
                                                        if (filtered != self.text) {
                                                            self.text = filtered;
                                                        }
                                                    }
                                                    accepted => {
                                                        root.rename-preset(row.preset, self.text);
                                                        root.rename-edit = 0;
                                                        list-keys.focus();
                                                    }
                                                    // Losing focus (clicking another row, a tab, …)
                                                    // cancels the edit — except when the focus loss
                                                    // comes from pressing ✓ or ✕ themselves.
                                                    changed has-focus => {
                                                        if (!self.has-focus && root.rename-edit == row.preset
                                                                && !ok-ta.has-hover && !cancel-ta.has-hover) {
                                                            root.rename-edit = 0;
                                                        }
                                                    }
                                                    key-pressed(event) => {
                                                        if (event.text == Key.Escape) {
                                                            root.rename-edit = 0;
                                                            list-keys.focus();
                                                            return accept;
                                                        }
                                                        reject
                                                    }
                                                }
                                            }
                                            ok-btn := Rectangle {
                                                width: 22px;
                                                border-radius: 4px;
                                                background: ok-ta.has-hover ? Theme.soft : transparent;
                                                Text {
                                                    text: "✓";
                                                    color: Theme.accent;
                                                    font-size: 13px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                ok-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.rename-preset(row.preset, rename-input.text);
                                                        root.rename-edit = 0;
                                                        list-keys.focus();
                                                    }
                                                }
                                            }
                                            Rectangle {
                                                width: 22px;
                                                border-radius: 4px;
                                                background: cancel-ta.has-hover ? Theme.soft : transparent;
                                                Text {
                                                    text: "✕";
                                                    color: Theme.muted;
                                                    font-size: 12px;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                                cancel-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        root.rename-edit = 0;
                                                        list-keys.focus();
                                                    }
                                                }
                                            }
                                        }

                                        row-ta := TouchArea {
                                            // Off while editing, so the editor gets the clicks.
                                            enabled: !editing;
                                            mouse-cursor: pointer;
                                            clicked => {
                                                root.cursor-row = index;
                                                list-keys.focus();
                                                root.preset-changed(row.preset);
                                            }
                                            // Right-click: context menu (named presets
                                            // only, one rename at a time).
                                            pointer-event(event) => {
                                                if (event.button == PointerEventButton.right && event.kind == PointerEventKind.down
                                                        && row.name != "" && root.rename-busy == 0) {
                                                    parent.menu-x = self.mouse-x;
                                                    parent.menu-y = self.mouse-y;
                                                    row-menu.show();
                                                }
                                            }
                                        }

                                        row-menu := PopupWindow {
                                            x: parent.menu-x;
                                            y: parent.menu-y;
                                            width: 110px;
                                            height: 32px;
                                            Rectangle {
                                                background: Theme.surface;
                                                border-width: 1px;
                                                border-color: Theme.edge;
                                                border-radius: 6px;
                                                drop-shadow-blur: 10px;
                                                drop-shadow-offset-y: 3px;
                                                drop-shadow-color: #000000aa;
                                                Rectangle {
                                                    x: 4px;
                                                    y: 4px;
                                                    width: parent.width - 8px;
                                                    height: 24px;
                                                    border-radius: 4px;
                                                    background: menu-ta.has-hover ? Theme.soft : transparent;
                                                    Text {
                                                        x: 8px;
                                                        height: parent.height;
                                                        text: "Rename";
                                                        color: Theme.ink;
                                                        font-size: 11px;
                                                        vertical-alignment: center;
                                                    }
                                                    menu-ta := TouchArea {
                                                        mouse-cursor: pointer;
                                                        clicked => {
                                                            root.rename-edit = row.preset;
                                                            row-menu.close();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // GLOBAL: levels row, then TUNER | TEMPO, then DEVICE |
                // MIDI. Everything but Preset Vol is pedal-wide (global
                // config) and never part of the EDITED state.
                Rectangle {
                    x: tray.pad;
                    y: tray.pad;
                    width: parent.width - 2 * tray.pad;
                    height: parent.height - 2 * tray.pad;
                    visible: root.tab == 1;

                    VerticalLayout {
                        spacing: 10px;
                        HorizontalLayout {
                            height: 24px;
                            ModuleTitle { text: "GLOBAL"; }
                        }

                        // Levels.
                        HorizontalLayout {
                            alignment: center;
                            // Per-preset output volume (pedal's PRESET VOLUME,
                            // 0..10; serial section 03, see tonex_serial.rs).
                            // Dimmed until read for this preset.
                            Knob {
                                width: tray.slot;
                                label: "Preset Vol";
                                size: 52px;
                                min-value: 0;
                                max-value: 10;
                                step: 0.1;
                                default-value: 5;
                                value <=> root.preset-level;
                                opacity: root.preset-level-known ? 1 : 0.5;
                                edited(v) => { root.preset-level-changed(v); }
                            }
                            Knob {
                                width: tray.slot;
                                label: "In Trim";
                                size: 52px;
                                enabled: root.globals-known;
                                min-value: -15;
                                max-value: 15;
                                step: 0.1;
                                default-value: 0;
                                unit: " dB";
                                value <=> root.global-trim;
                                edited(v) => { root.global-changed(0, v); }
                            }
                            Knob {
                                width: tray.slot;
                                label: "Master";
                                size: 52px;
                                enabled: root.globals-known;
                                min-value: -40;
                                max-value: 3;
                                step: 0.1;
                                default-value: 0;
                                unit: " dB";
                                value <=> root.global-volume;
                                edited(v) => { root.global-changed(1, v); }
                            }
                            // Interface (USB) volume; -40 lower end is a guess.
                            Knob {
                                width: tray.slot;
                                label: "Interface";
                                size: 52px;
                                enabled: root.globals-known;
                                min-value: -40;
                                max-value: 0;
                                step: 1;
                                decimals: 0;
                                default-value: -10;
                                unit: " dB";
                                value <=> root.global-interface;
                                edited(v) => { root.global-changed(2, v); }
                            }
                        }

                        // Both group rows split 42 / 58 so their seams line
                        // up (MIDI needs ~256 px at the 540 px minimum).
                        HorizontalLayout {
                            spacing: 8px;
                            GlobalGroup {
                                width: (parent.width - 8px) * 0.42;
                                title: "TUNER";
                                VerticalLayout {
                                    alignment: center;
                                    Stepper {
                                        enabled: root.globals-known;
                                        value-width: 44px; // "Through"
                                        height: 24px;
                                        options: ["Off", "Through", "Muted"];
                                        index <=> root.tuner-mode;
                                        picked(i) => { root.global-changed(3, i); }
                                    }
                                }
                                Knob {
                                    width: 52px;
                                    horizontal-stretch: 0;
                                    label: "Ref";
                                    size: 30px;
                                    enabled: root.globals-known;
                                    min-value: 427;
                                    max-value: 453;
                                    step: 1;
                                    decimals: 0;
                                    default-value: 440;
                                    unit: " Hz";
                                    value <=> root.tuner-ref;
                                    edited(v) => { root.global-changed(4, v); }
                                }
                            }
                            // Tap tempo: MIDI CC10 (also key T). The BPM is
                            // the pedal's (global 18), re-read after taps.
                            GlobalGroup {
                                horizontal-stretch: 1;
                                title: "TEMPO";
                                VerticalLayout {
                                    alignment: center;
                                    tap-btn := HwButton {
                                        width: 44px;
                                        height: 32px;
                                        checked: root.flash == 2;
                                        clicked => {
                                            root.tap-tempo();
                                            main-keys.focus();
                                        }
                                        Text {
                                            width: parent.width;
                                            height: parent.height;
                                            text: "TAP";
                                            color: tap-btn.hover ? Theme.hw-ink-hover : Theme.hw-ink;
                                            font-size: 10px;
                                            font-weight: 600;
                                            font-family: Theme.mono-font;
                                            letter-spacing: 1.2px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Knob {
                                    width: 56px;
                                    horizontal-stretch: 0;
                                    label: "BPM";
                                    size: 30px;
                                    enabled: root.globals-known;
                                    min-value: 30;
                                    max-value: 300;
                                    step: 0.5;
                                    decimals: 1;
                                    default-value: 120;
                                    value <=> root.tempo-bpm;
                                    edited(v) => { root.global-changed(5, v); }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Stepper {
                                        enabled: root.globals-known;
                                        value-width: 38px; // "Global"
                                        height: 24px;
                                        options: ["Global", "Preset"];
                                        index <=> root.tempo-mode;
                                        picked(i) => { root.global-changed(6, i); }
                                    }
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            // Pedal-wide cab sim kill switch, and how the
                            // pedal's own display titles presets (doesn't
                            // change this app's list).
                            GlobalGroup {
                                width: (parent.width - 8px) * 0.42;
                                title: "DEVICE";
                                StateButton {
                                    horizontal-stretch: 0;
                                    width: 64px;
                                    height: 24px;
                                    enabled: root.globals-known;
                                    on <=> root.cab-sim;
                                    on-text: "Cab On";
                                    off-text: "Cab Off";
                                    toggled(on) => { root.global-changed(7, on ? 1 : 0); }
                                }
                                Stepper {
                                    enabled: root.globals-known;
                                    value-width: 58px; // "Bank+Name"
                                    height: 24px;
                                    options: ["Name", "PC+Name", "Bank+Name"];
                                    index <=> root.naming;
                                    picked(i) => { root.global-changed(11, i); }
                                }
                            }
                            // Channel used for every MIDI message the app sends.
                            GlobalGroup {
                                horizontal-stretch: 1;
                                title: "MIDI";
                                Stepper {
                                    enabled: root.globals-known;
                                    value-width: 34px; // "Ch 16"
                                    height: 24px;
                                    options: ["Ch 1", "Ch 2", "Ch 3", "Ch 4", "Ch 5", "Ch 6", "Ch 7", "Ch 8",
                                        "Ch 9", "Ch 10", "Ch 11", "Ch 12", "Ch 13", "Ch 14", "Ch 15", "Ch 16"];
                                    index <=> root.midi-channel-index;
                                    picked(i) => { root.global-changed(8, i + 1); }
                                }
                                StateButton {
                                    horizontal-stretch: 0;
                                    width: 48px;
                                    height: 24px;
                                    enabled: root.globals-known;
                                    on <=> root.midi-thru;
                                    on-text: "Thru";
                                    off-text: "Thru";
                                    toggled(on) => { root.global-changed(9, on ? 1 : 0); }
                                }
                                Stepper {
                                    enabled: root.globals-known;
                                    value-width: 58px; // "Slave USB"
                                    height: 24px;
                                    options: ["Clock Off", "Master", "Slave Mix", "Slave USB"];
                                    index <=> root.midi-clock;
                                    picked(i) => { root.global-changed(10, i); }
                                }
                            }
                        }
                    }
                }

                // GATE (written and read over USB serial, see fx.rs).
                Rectangle {
                    x: tray.pad;
                    y: tray.pad;
                    width: parent.width - 2 * tray.pad;
                    height: parent.height - 2 * tray.pad;
                    visible: root.tab == 2;

                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            height: 24px;
                            spacing: 6px;
                            ModuleTitle { text: "NOISE GATE"; }
                            StateButton {
                                horizontal-stretch: 0;
                                width: 76px;
                                height: 24px;
                                on <=> root.gate-post;
                                on-text: "Post amp";
                                off-text: "Pre amp";
                                toggled(on) => { root.fx-changed(41, on ? 1 : 0); }
                            }
                            OnOffChip {
                                on <=> root.gate-enabled;
                                toggled(on) => { root.fx-changed(40, on ? 1 : 0); }
                            }
                        }
                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Knob {
                                    width: tray.slot;
                                    label: "Threshold";
                                    size: 52px;
                                    min-value: -100;
                                    max-value: 0;
                                    step: 1;
                                    decimals: 0;
                                    default-value: -64;
                                    unit: " dB";
                                    value <=> root.gate-threshold;
                                    edited(v) => { root.fx-changed(42, v); }
                                }
                                Knob {
                                    width: tray.slot;
                                    label: "Release";
                                    size: 52px;
                                    min-value: 5;
                                    max-value: 500;
                                    step: 1;
                                    decimals: 0;
                                    default-value: 20;
                                    unit: " ms";
                                    value <=> root.gate-release;
                                    edited(v) => { root.fx-changed(43, v); }
                                }
                                Knob {
                                    width: tray.slot;
                                    label: "Depth";
                                    size: 52px;
                                    min-value: -100;
                                    max-value: -20;
                                    step: 1;
                                    decimals: 0;
                                    default-value: -60;
                                    unit: " dB";
                                    value <=> root.gate-depth;
                                    edited(v) => { root.fx-changed(44, v); }
                                }
                            }
                        }
                    }
                }

                // COMP (USB serial, see fx.rs FxControl).
                Rectangle {
                    x: tray.pad;
                    y: tray.pad;
                    width: parent.width - 2 * tray.pad;
                    height: parent.height - 2 * tray.pad;
                    visible: root.tab == 3;

                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            height: 24px;
                            spacing: 6px;
                            ModuleTitle { text: "COMPRESSOR"; }
                            StateButton {
                                horizontal-stretch: 0;
                                width: 76px;
                                height: 24px;
                                on <=> root.comp-post;
                                on-text: "Post amp";
                                off-text: "Pre amp";
                                toggled(on) => { root.fx-changed(21, on ? 1 : 0); }
                            }
                            OnOffChip {
                                on <=> root.comp-enabled;
                                toggled(on) => { root.fx-changed(20, on ? 1 : 0); }
                            }
                        }
                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Knob {
                                    width: tray.slot;
                                    label: "Threshold";
                                    size: 52px;
                                    min-value: -40;
                                    max-value: 0;
                                    step: 0.1;
                                    default-value: -14;
                                    unit: " dB";
                                    value <=> root.comp-threshold;
                                    edited(v) => { root.fx-changed(22, v); }
                                }
                                Knob {
                                    width: tray.slot;
                                    label: "Gain";
                                    size: 52px;
                                    min-value: -30;
                                    max-value: 10;
                                    step: 0.1;
                                    default-value: -12;
                                    unit: " dB";
                                    value <=> root.comp-gain;
                                    edited(v) => { root.fx-changed(23, v); }
                                }
                                Knob {
                                    width: tray.slot;
                                    label: "Attack";
                                    size: 52px;
                                    min-value: 1;
                                    max-value: 51;
                                    step: 1;
                                    decimals: 0;
                                    default-value: 14;
                                    unit: " ms";
                                    value <=> root.comp-attack;
                                    edited(v) => { root.fx-changed(24, v); }
                                }
                            }
                        }
                    }
                }

                // AMP: gain/volume/presence/depth and the EQ band gains are
                // MIDI CCs; mix, EQ frequencies, mid Q and EQ position are
                // serial-only (fx ids 60..65). Values are read from the
                // current preset over USB serial. Groups: GAIN | MODEL, EQ.
                Rectangle {
                    x: tray.pad;
                    y: tray.pad;
                    width: parent.width - 2 * tray.pad;
                    height: parent.height - 2 * tray.pad;
                    visible: root.tab == 4;

                    VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        HorizontalLayout {
                            height: 24px;
                            spacing: 6px;
                            ModuleTitle { text: "AMPLIFIER"; }
                            // EQ before or after the amp model (param 10).
                            StateButton {
                                horizontal-stretch: 0;
                                width: 76px;
                                height: 24px;
                                enabled: root.eq-post-known;
                                on <=> root.eq-post;
                                on-text: "Post amp";
                                off-text: "Pre amp";
                                toggled(on) => { root.fx-changed(65, on ? 1 : 0); }
                            }
                            // Amp enable/bypass toggle (written over USB serial).
                            OnOffChip {
                                on <=> root.amp-enabled;
                                toggled(on) => { root.amp-enable-changed(on); }
                            }
                        }
                        // Group borders cost height: trimmed paddings keep
                        // the knob sizes within the 320 px tray.
                        HorizontalLayout {
                            spacing: 8px;
                            GlobalGroup {
                                title: "GAIN";
                                horizontal-stretch: 2;
                                pad-top: 8px;
                                pad-bottom: 4px;
                                k-gain := Knob {
                                    width: 72px;
                                    size: 52px;
                                    label: "Gain";
                                    value <=> root.amp-gain;
                                    edited(v) => { root.amp-param-changed(0, v); }
                                }

                                k-volume := Knob {
                                    width: 72px;
                                    size: 52px;
                                    label: "Volume";
                                    value <=> root.amp-volume;
                                    edited(v) => { root.amp-param-changed(1, v); }
                                }
                            }
                            GlobalGroup {
                                title: "MODEL";
                                horizontal-stretch: 3;
                                pad-top: 8px;
                                pad-bottom: 4px;
                                // Mix: serial-only (fx id 63), locked until
                                // read, double-click returns to the loaded value.
                                Knob {
                                    width: 72px;
                                    size: 52px;
                                    label: "Mix";
                                    unit: "%";
                                    min-value: 0;
                                    max-value: 100;
                                    step: 1;
                                    decimals: 0;
                                    enabled: root.amp-mix-known;
                                    default-value: root.amp-mix-default;
                                    value <=> root.amp-mix;
                                    edited(v) => { root.fx-changed(63, v); }
                                }

                                k-presence := Knob {
                                    width: 72px;
                                    size: 52px;
                                    label: "Presence";
                                    value <=> root.amp-presence;
                                    edited(v) => { root.amp-param-changed(2, v); }
                                }

                                k-depth := Knob {
                                    width: 72px;
                                    size: 52px;
                                    label: "Depth";
                                    value <=> root.amp-depth;
                                    edited(v) => { root.amp-param-changed(3, v); }
                                }
                            }
                        }
                        // EQ bands: gain knob (MIDI CC) with its frequency
                        // knob (serial, fx ids 60..62) up-right; the mid band
                        // also has Q (fx id 64) up-left (EqPair).
                        GlobalGroup {
                            title: "EQ";
                            // Extra top padding keeps the small knobs' labels
                            // clear of the group's border line.
                            pad-top: 18px;
                            pad-bottom: 4px;
                            content-alignment: LayoutAlignment.space-between;
                                k-bass := EqPair {
                                    width: tray.slot;
                                    label: "Bass";
                                    gain <=> root.amp-bass;
                                    gain-edited(v) => { root.amp-param-changed(4, v); }
                                    freq-min: 75;
                                    freq-max: 600;
                                    freq-enabled: root.eq-freq-known;
                                    freq-default: root.eq-bass-freq-default;
                                    freq <=> root.eq-bass-freq;
                                    freq-edited(v) => { root.fx-changed(60, v); }
                                }

                                k-mid := EqPair {
                                    width: tray.slot + 40px;
                                    label: "Mid";
                                    gain <=> root.amp-mid;
                                    gain-edited(v) => { root.amp-param-changed(5, v); }
                                    freq-min: 150;
                                    freq-max: 5000;
                                    freq-enabled: root.eq-freq-known;
                                    freq-default: root.eq-mid-freq-default;
                                    freq <=> root.eq-mid-freq;
                                    freq-edited(v) => { root.fx-changed(61, v); }
                                    has-q: true;
                                    q-enabled: root.eq-mid-q-known;
                                    q-default: root.eq-mid-q-default;
                                    q <=> root.eq-mid-q;
                                    q-edited(v) => { root.fx-changed(64, v); }
                                }

                                k-treble := EqPair {
                                    width: tray.slot;
                                    label: "Treble";
                                    gain <=> root.amp-treble;
                                    gain-edited(v) => { root.amp-param-changed(6, v); }
                                    freq-min: 1000;
                                    freq-max: 4000;
                                    freq-enabled: root.eq-freq-known;
                                    freq-default: root.eq-treble-freq-default;
                                    freq <=> root.eq-treble-freq;
                                    freq-edited(v) => { root.fx-changed(62, v); }
                                }
                        }
                    }
                }

                // CAB. The chip switches the cab off (type 2) or back to the
                // last non-off type; VIR controls are active only in VIR mode
                // (dimmed otherwise, layout unchanged).
                Rectangle {
                    x: tray.pad;
                    y: tray.pad;
                    width: parent.width - 2 * tray.pad;
                    height: parent.height - 2 * tray.pad;
                    visible: root.tab == 5;

                    property <bool> vir: root.cab-type == 1;

                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            height: 24px;
                            spacing: 6px;
                            ModuleTitle { text: "CABINET"; }
                            Stepper {
                                value-width: 66px; // "Tone Model"
                                height: 24px;
                                options: ["Tone Model", "VIR", "Off"];
                                index <=> root.cab-type;
                                picked(i) => { root.fx-changed(50, i); }
                            }
                            OnOffChip {
                                on <=> root.cab-on;
                                toggled(on) => {
                                    root.cab-type = on ? root.cab-last-on : 2;
                                    root.fx-changed(50, root.cab-type);
                                }
                            }
                        }
                        // VIR cab model and mics: too wide for the header.
                        HorizontalLayout {
                            height: 24px;
                            spacing: 6px;
                            alignment: start;
                            Stepper {
                                enabled: vir;
                                value-width: 58px; // "412 B8000"
                                height: 24px;
                                options: root.cab-model-names;
                                index <=> root.cab-model;
                                picked(i) => { root.fx-changed(51, i); }
                            }
                            Stepper {
                                enabled: vir;
                                // Mic 1, tinted like its dot on the mic pad.
                                value-width: 52px; // "Cond 414"
                                value-color: Theme.accent;
                                height: 24px;
                                options: ["Cond 414", "Dyn 57", "Rbn 121"];
                                list-options: ["Condenser 414", "Dynamic 57", "Ribbon 121"];
                                index <=> root.cab-mic1;
                                picked(i) => { root.fx-changed(53, i); }
                            }
                            Stepper {
                                enabled: vir;
                                // Mic 2, tinted like its dot on the mic pad.
                                value-width: 52px; // "Cond 414"
                                value-color: Theme.mic2;
                                height: 24px;
                                options: ["Cond 414", "Dyn 57", "Rbn 121"];
                                list-options: ["Condenser 414", "Dynamic 57", "Ribbon 121"];
                                index <=> root.cab-mic2;
                                picked(i) => { root.fx-changed(56, i); }
                            }
                        }
                        HorizontalLayout {
                            vertical-stretch: 1;
                            spacing: 12px;
                            // Non-positional cab controls.
                            VerticalLayout {
                                alignment: center;
                                spacing: 14px;
                                Knob {
                                    width: 80px;
                                    label: "Reso";
                                    size: 52px;
                                    enabled: vir;
                                    default-value: 0;
                                    value <=> root.cab-reso;
                                    edited(v) => { root.fx-changed(52, v); }
                                }
                                Knob {
                                    width: 80px;
                                    label: "Blend";
                                    size: 52px;
                                    enabled: vir;
                                    min-value: -100;
                                    max-value: 100;
                                    step: 1;
                                    decimals: 0;
                                    default-value: 0;
                                    value <=> root.cab-blend;
                                    edited(v) => { root.fx-changed(59, v); }
                                }
                            }
                            // Mic positions (fx ids 54/55 mic 1 X/Z, 57/58
                            // mic 2 X/Z; same writes as the former knobs).
                            MicPad {
                                horizontal-stretch: 1;
                                enabled: vir;
                                m1x <=> root.cab-mic1-x;
                                m1z <=> root.cab-mic1-z;
                                m2x <=> root.cab-mic2-x;
                                m2z <=> root.cab-mic2-z;
                                m1x-default: root.cab-mic1-x-default;
                                m1z-default: root.cab-mic1-z-default;
                                m2x-default: root.cab-mic2-x-default;
                                m2z-default: root.cab-mic2-z-default;
                                edited(which, v) => {
                                    root.fx-changed([54, 55, 57, 58][which], v);
                                }
                            }
                        }
                    }
                }

                // MOD; knob set depends on the selected type.
                Rectangle {
                    x: tray.pad;
                    y: tray.pad;
                    width: parent.width - 2 * tray.pad;
                    height: parent.height - 2 * tray.pad;
                    visible: root.tab == 6;

                    // Per-type knob definitions, indexed by mod-model
                    // (Chorus, Tremolo, Phaser, Flanger, Rotary); ranges
                    // must match MOD_KNOBS in fx.rs.
                    property <int> m: clamp(root.mod-model, 0, 4);
                    property <bool> has-k4: m == 1 || m == 3 || m == 4;

                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            height: 24px;
                            spacing: 6px;
                            ModuleTitle { text: "MODULATION"; }
                            Stepper {
                                value-width: 48px; // "Tremolo"
                                height: 24px;
                                options: ["Chorus", "Tremolo", "Phaser", "Flanger", "Rotary"];
                                index <=> root.mod-model;
                                picked(i) => { root.fx-changed(32, i); }
                            }
                            StateButton {
                                horizontal-stretch: 0;
                                width: 76px;
                                height: 24px;
                                on <=> root.mod-post;
                                on-text: "Post amp";
                                off-text: "Pre amp";
                                toggled(on) => { root.fx-changed(31, on ? 1 : 0); }
                            }
                            StateButton {
                                horizontal-stretch: 0;
                                width: 70px;
                                height: 24px;
                                on <=> root.mod-sync;
                                on-text: "Sync On";
                                off-text: "Sync Off";
                                toggled(on) => { root.fx-changed(33, on ? 1 : 0); }
                            }
                            OnOffChip {
                                on <=> root.mod-enabled;
                                toggled(on) => { root.fx-changed(30, on ? 1 : 0); }
                            }
                        }
                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                // Synced: note division instead of rate/speed.
                                if root.mod-sync: VerticalLayout {
                                    width: tray.slot;
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: "Division";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        Stepper {
                                            value-width: 42px; // "1/32 D"
                                            options: root.delay-divisions;
                                            index <=> root.mod-division;
                                            picked(i) => { root.fx-changed(34, i); }
                                        }
                                    }
                                }
                                if !root.mod-sync: Knob {
                                    width: tray.slot;
                                    label: m == 4 ? "Speed" : "Rate";
                                    size: 52px;
                                    min-value: m == 4 ? 0 : 0.1;
                                    max-value: m == 4 ? 400 : 10;
                                    step: m == 4 ? 1 : 0.1;
                                    decimals: m == 4 ? 0 : 1;
                                    unit: m == 4 ? "" : " Hz";
                                    default-value: m == 4 ? 200 : 0.5;
                                    value <=> root.mod-k1;
                                    edited(v) => { root.fx-changed(35, v); }
                                }
                                Knob {
                                    width: tray.slot;
                                    label: ["Depth", "Shape", "Depth", "Depth", "Radius"][m];
                                    size: 52px;
                                    min-value: 0;
                                    max-value: [100, 10, 100, 100, 300][m];
                                    step: m == 1 ? 0.1 : 1;
                                    decimals: m == 1 ? 1 : 0;
                                    unit: m == 1 || m == 4 ? "" : "%";
                                    default-value: m == 4 ? 150 : 0;
                                    value <=> root.mod-k2;
                                    edited(v) => { root.fx-changed(36, v); }
                                }
                                Knob {
                                    width: tray.slot;
                                    label: ["Level", "Spread", "Level", "Feedback", "Spread"][m];
                                    size: 52px;
                                    min-value: 0;
                                    max-value: [10, 100, 10, 100, 100][m];
                                    step: m == 0 || m == 2 ? 0.1 : 1;
                                    decimals: m == 0 || m == 2 ? 1 : 0;
                                    unit: m == 0 || m == 2 ? "" : "%";
                                    default-value: m == 0 || m == 2 ? 5 : 0;
                                    value <=> root.mod-k3;
                                    edited(v) => { root.fx-changed(37, v); }
                                }
                                if has-k4: Knob {
                                    width: tray.slot;
                                    label: "Level";
                                    size: 52px;
                                    min-value: 0;
                                    max-value: 10;
                                    step: 0.1;
                                    default-value: 5;
                                    value <=> root.mod-k4;
                                    edited(v) => { root.fx-changed(38, v); }
                                }
                            }
                        }
                    }
                }

                // DELAY (all values written and read over USB serial).
                Rectangle {
                    x: tray.pad;
                    y: tray.pad;
                    width: parent.width - 2 * tray.pad;
                    height: parent.height - 2 * tray.pad;
                    visible: root.tab == 7;

                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            height: 24px;
                            spacing: 6px;
                            ModuleTitle { text: "DELAY"; }
                            Stepper {
                                value-width: 48px; // "Digital"
                                height: 24px;
                                options: ["Digital", "Tape"];
                                index <=> root.dly-model;
                                picked(i) => { root.fx-changed(2, i); }
                            }
                            StateButton {
                                horizontal-stretch: 0;
                                width: 76px;
                                height: 24px;
                                on <=> root.dly-post;
                                on-text: "Post amp";
                                off-text: "Pre amp";
                                toggled(on) => { root.fx-changed(1, on ? 1 : 0); }
                            }
                            StateButton {
                                horizontal-stretch: 0;
                                width: 70px;
                                height: 24px;
                                on <=> root.dly-sync;
                                on-text: "Sync On";
                                off-text: "Sync Off";
                                toggled(on) => { root.fx-changed(3, on ? 1 : 0); }
                            }
                            StateButton {
                                horizontal-stretch: 0;
                                width: 76px;
                                height: 24px;
                                on <=> root.dly-pingpong;
                                on-text: "Ping-pong";
                                off-text: "Normal";
                                toggled(on) => { root.fx-changed(7, on ? 1 : 0); }
                            }
                            OnOffChip {
                                on <=> root.dly-enabled;
                                toggled(on) => { root.fx-changed(0, on ? 1 : 0); }
                            }
                        }
                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                // Synced: note division instead of a time in ms.
                                if root.dly-sync: VerticalLayout {
                                    width: tray.slot;
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: "Division";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        Stepper {
                                            value-width: 42px; // "1/32 D"
                                            options: root.delay-divisions;
                                            index <=> root.dly-division;
                                            picked(i) => { root.fx-changed(4, i); }
                                        }
                                    }
                                }
                                if !root.dly-sync: Knob {
                                    width: tray.slot;
                                    label: "Time";
                                    size: 52px;
                                    min-value: 0;
                                    max-value: 1000;
                                    step: 1;
                                    decimals: 0;
                                    unit: " ms";
                                    default-value: 500;
                                    value <=> root.dly-time;
                                    edited(v) => { root.fx-changed(5, v); }
                                }
                                Knob {
                                    width: tray.slot;
                                    label: "Feedback";
                                    size: 52px;
                                    min-value: 0;
                                    max-value: 100;
                                    step: 1;
                                    decimals: 0;
                                    unit: "%";
                                    default-value: 0;
                                    value <=> root.dly-feedback;
                                    edited(v) => { root.fx-changed(6, v); }
                                }
                                Knob {
                                    width: tray.slot;
                                    label: "Mix";
                                    size: 52px;
                                    min-value: 0;
                                    max-value: 100;
                                    step: 1;
                                    decimals: 0;
                                    unit: "%";
                                    default-value: 0;
                                    value <=> root.dly-mix;
                                    edited(v) => { root.fx-changed(8, v); }
                                }
                            }
                        }
                    }
                }

                // REVERB (USB serial).
                Rectangle {
                    x: tray.pad;
                    y: tray.pad;
                    width: parent.width - 2 * tray.pad;
                    height: parent.height - 2 * tray.pad;
                    visible: root.tab == 8;

                    VerticalLayout {
                        spacing: 8px;
                        HorizontalLayout {
                            height: 24px;
                            spacing: 6px;
                            ModuleTitle { text: "REVERB"; }
                            Stepper {
                                value-width: 54px; // "Spring 1"
                                height: 24px;
                                options: ["Spring 1", "Spring 2", "Spring 3", "Spring 4", "Room", "Plate"];
                                index <=> root.rvb-model;
                                picked(i) => { root.fx-changed(12, i); }
                            }
                            StateButton {
                                horizontal-stretch: 0;
                                width: 76px;
                                height: 24px;
                                on <=> root.rvb-post;
                                on-text: "Post amp";
                                off-text: "Pre amp";
                                toggled(on) => { root.fx-changed(11, on ? 1 : 0); }
                            }
                            OnOffChip {
                                on <=> root.rvb-enabled;
                                toggled(on) => { root.fx-changed(10, on ? 1 : 0); }
                            }
                        }
                        VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Knob {
                                    width: tray.slot;
                                    label: "Time";
                                    size: 52px;
                                    min-value: 0;
                                    max-value: 10;
                                    step: 0.1;
                                    default-value: 5;
                                    value <=> root.rvb-time;
                                    edited(v) => { root.fx-changed(13, v); }
                                }
                                Knob {
                                    width: tray.slot;
                                    label: "Predelay";
                                    size: 52px;
                                    min-value: 0;
                                    max-value: 500;
                                    step: 1;
                                    decimals: 0;
                                    unit: " ms";
                                    default-value: 0;
                                    value <=> root.rvb-predelay;
                                    edited(v) => { root.fx-changed(14, v); }
                                }
                                Knob {
                                    width: tray.slot;
                                    label: "Mix";
                                    size: 52px;
                                    min-value: 0;
                                    max-value: 100;
                                    step: 1;
                                    decimals: 0;
                                    unit: "%";
                                    default-value: 0;
                                    value <=> root.rvb-mix;
                                    edited(v) => { root.fx-changed(16, v); }
                                }
                                Knob {
                                    width: tray.slot;
                                    label: "Color";
                                    size: 52px;
                                    min-value: -10;
                                    max-value: 10;
                                    step: 0.1;
                                    default-value: 0;
                                    value <=> root.rvb-color;
                                    edited(v) => { root.fx-changed(15, v); }
                                }
                            }
                        }
                    }
                }
            }
        }

        // Status bar: LED + status on the left, port name + reconnect right.
        Rectangle {
            background: Theme.status-bg;
            // Follows the chassis' rounded bottom corners.
            border-bottom-left-radius: 11px;
            border-bottom-right-radius: 11px;
            clip: true;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                Rectangle {
                    height: 1px;
                    background: Theme.status-line;
                }

                HorizontalLayout {
                    height: 30px;
                    padding-left: 16px;
                    padding-right: 10px;
                    spacing: 8px;

                    VerticalLayout {
                        alignment: center;
                        // Green when connected, blinking amber while
                        // reconnecting, steady red without port access,
                        // dark gray otherwise.
                        Rectangle {
                            property <bool> amber: !root.connected && root.reconnecting;
                            property <bool> red: root.no-access;
                            property <color> lit: root.connected ? Theme.ok
                                : (self.red ? Theme.error : (self.amber ? Theme.accent : Theme.led-off));
                            width: 6px;
                            height: 6px;
                            border-radius: 3px;
                            background: self.lit;
                            opacity: self.amber && root.led-dim ? 0.25 : 1;
                            drop-shadow-blur: root.connected || self.amber || self.red ? 6px : 0px;
                            drop-shadow-color: root.connected || self.amber || self.red ? self.lit.with-alpha(0.9) : transparent;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.status-note != "" ? root.status-note : root.status-text;
                        color: root.status-note != "" ? Theme.error : Theme.status-ink;
                        font-size: 10px;
                        font-weight: 500;
                        font-family: Theme.mono-font;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    if root.update-version != "": VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 18px;
                            border-radius: 3px;
                            border-width: 1px;
                            border-color: update-ta.has-hover ? Theme.accent : Theme.accent.with-alpha(0.6);
                            background: update-ta.has-hover ? Theme.accent.with-alpha(0.12) : transparent;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text {
                                    text: "UPDATE " + root.update-version;
                                    color: Theme.accent;
                                    font-size: 9px;
                                    font-weight: 600;
                                    font-family: Theme.mono-font;
                                    letter-spacing: 0.8px;
                                    vertical-alignment: center;
                                    wrap: no-wrap;
                                }
                            }
                            update-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.open-releases();
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        alignment: center;
                        StyledButton {
                            width: 22px;
                            height: 22px;
                            radius: 5px;
                            text: "⟳";
                            font-size: 13px;
                            font-weight: 500;
                            clicked => {
                                root.reconnect();
                            }
                        }
                    }
                }
            }
        }
    }
}
