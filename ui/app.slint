// TX Open Studio — preset switcher UI

import { ListView } from "std-widgets.slint";

export global Theme {
    out property <color> bg: #141b18;
    out property <color> surface: #1d2721;
    out property <color> surface-alt: #18211c;
    out property <color> soft: #28352c;
    out property <color> field: #202e25;
    out property <color> hover: #2b3a2f;
    out property <color> selected: #304934;
    out property <color> border: #3a4b3e;
    out property <color> selected-border: #86b778;
    out property <color> muted: #a6b6a3;
    out property <color> ink: #edf3e9;
    out property <color> secondary-ink: #bed4b2;
    out property <color> accent: #3e7750;
    out property <color> accent-hover: #4b8b5e;
    out property <color> ok: #86b778;
    out property <color> error: #c05b4d;
    // Muted warm yellow for "modified" markers.
    out property <color> changed: #d4a72c;
}

// One row of the preset list. `number` is the bank number once the name is
// known (bare preset number before), `kind` the character colour group
// (0 = no badge; see character_kind in main.rs).
export struct PresetRow {
    number: string,
    name: string,
    character: string,
    kind: int,
}

// Muted colours per preset character group, shared by list and header.
export global CharacterColors {
    pure public function of(kind: int) -> color {
        if (kind == 1) { return #4a8a6a; } // clean
        if (kind == 2) { return #a07d1c; } // crunch
        if (kind == 3) { return #b0632c; } // drive
        if (kind == 4) { return #a84a42; } // high gain / lead
        if (kind == 5) { return #8a5bb0; } // stomp
        if (kind == 6) { return #3d78b8; } // bass
        if (kind == 7) { return #8a7a50; } // acoustic
        return Theme.muted;
    }
}

// Small badge showing a preset's character ("CLEAN", "DRIVE", ...).
component CharacterBadge inherits Rectangle {
    in property <string> text;
    in property <int> kind;
    in property <length> font-size: 10px;
    property <color> tint: CharacterColors.of(root.kind);

    horizontal-stretch: 0;
    background: root.tint.with-alpha(0.14);
    border-radius: 5px;
    border-width: 1px;
    border-color: root.tint.with-alpha(0.8);

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        padding-top: 1px;
        padding-bottom: 1px;
        Text {
            text: root.text;
            color: root.tint.brighter(0.35);
            font-size: root.font-size;
            font-weight: 600;
            vertical-alignment: center;
            wrap: no-wrap;
        }
    }
}

// Hand-made button: std-widgets don't follow the custom palette well.
component StyledButton inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 16px;
    in property <int> font-weight: 600;
    in property <bool> active: false;
    in property <color> base-color: Theme.soft;
    callback clicked();

    border-radius: 10px;
    border-width: 1px;
    border-color: root.active ? Theme.selected-border : Theme.border;
    background: ta.pressed ? Theme.selected : (ta.has-hover ? Theme.hover : root.base-color);
    min-height: 32px;
    min-width: 40px;

    animate background { duration: 90ms; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.ink : Theme.secondary-ink;
        font-size: root.font-size;
        font-weight: root.font-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Rotary knob with label above and value below. Vertical drag changes the
// value in `step` increments (a full sweep is ~150 px). `edited` fires only
// for user drags, not when the value is set programmatically (e.g. read back
// from the pedal). Shown with `decimals` (0 or 1) and a `unit` suffix.
// Double-click resets to `default-value` (sent like a normal edit).
component Knob inherits VerticalLayout {
    in property <string> label;
    in-out property <float> value: 5;
    in property <float> min-value: 0;
    in property <float> max-value: 10;
    in property <float> step: 0.1;
    in property <float> default-value: 5;
    in property <int> decimals: 1;
    in property <string> unit;
    in property <length> size: 48px;
    // false: display only (no drag, no double-click reset), dimmed.
    in property <bool> enabled: true;
    callback edited(float);
    out property <bool> active: ta.pressed;
    // Sweep of 270°: min → -135°, max → +135° (0° = straight up).
    property <float> frac: clamp((root.value - root.min-value) / max(root.max-value - root.min-value, 0.0001), 0, 1);
    property <angle> sweep: (-135 + root.frac * 270) * 1deg;
    property <int> tenths: round(root.value * 10);
    property <int> abs-tenths: abs(root.tenths);
    property <string> number: root.decimals == 0
        ? "\{round(root.value)}"
        : (root.tenths < 0 ? "-" : "") + "\{floor(root.abs-tenths / 10)}"
            + (mod(root.abs-tenths, 10) == 0 ? "" : ".\{mod(root.abs-tenths, 10)}");
    property <float> drag-start: 0;

    spacing: 4px;
    min-width: root.size;
    horizontal-stretch: 1;

    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        horizontal-alignment: center;
        overflow: elide;
        wrap: no-wrap;
    }

    HorizontalLayout {
        alignment: center;

        dial := Rectangle {
            width: root.size;
            height: root.size;
            border-radius: self.width / 2;
            background: Theme.field;
            border-width: 1px;
            border-color: ta.has-hover || ta.pressed ? Theme.muted : Theme.border;

            // Indicator dot on a circle of radius r, positioned via sin/cos.
            property <length> r: self.width / 2 - 9px;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.selected-border;
                x: dial.width / 2 + dial.r * sin(root.sweep) - self.width / 2;
                y: dial.height / 2 - dial.r * cos(root.sweep) - self.height / 2;
            }

            opacity: root.enabled ? 1 : 0.55;
            ta := TouchArea {
                enabled: root.enabled;
                mouse-cursor: root.enabled ? ns-resize : default;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.drag-start = root.value;
                    }
                }
                double-clicked => {
                    root.value = root.default-value;
                    root.edited(root.default-value);
                }
                moved => {
                    if (self.pressed) {
                        let v = root.drag-start + (self.pressed-y - self.mouse-y) / 150px * (root.max-value - root.min-value);
                        let nv = clamp(round(v / root.step) * root.step, root.min-value, root.max-value);
                        if (nv != root.value) {
                            root.value = nv;
                            root.edited(nv);
                        }
                    }
                }
            }
        }
    }

    Text {
        text: root.number + root.unit;
        color: Theme.secondary-ink;
        font-size: 12px;
        font-family: "monospace";
        horizontal-alignment: center;
        overflow: elide;
        wrap: no-wrap;
    }
}

// On/Off chip for an effect block header: green dot + "On", muted "Off".
component OnOffChip inherits Rectangle {
    in-out property <bool> on: true;
    callback toggled(bool);

    horizontal-stretch: 0;
    background: chip-ta.pressed ? Theme.selected : (chip-ta.has-hover ? Theme.hover : Theme.soft);
    border-radius: 6px;
    border-width: 1px;
    border-color: root.on ? Theme.ok : Theme.border;
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.on ? Theme.ok : Theme.muted.with-alpha(0.5);
            }
        }
        Text {
            text: root.on ? "On" : "Off";
            color: root.on ? Theme.ink : Theme.muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    chip-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// Small two-state button whose caption names the current state
// ("Pre amp" / "Post amp"); highlighted when `on`.
component StateButton inherits Rectangle {
    in-out property <bool> on;
    in property <string> on-text;
    in property <string> off-text;
    callback toggled(bool);

    height: 26px;
    min-width: 32px;
    horizontal-stretch: 1;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.on ? Theme.selected-border : Theme.border;
    background: sb-ta.pressed ? Theme.selected : (sb-ta.has-hover ? Theme.hover : Theme.field);
    animate background { duration: 90ms; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.on ? root.on-text : root.off-text;
        color: root.on ? Theme.ink : Theme.secondary-ink;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    sb-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// Compact selector: ‹ label › cycling through `options` (no wrap-around).
component Stepper inherits Rectangle {
    in property <[string]> options;
    in-out property <int> index;
    callback picked(int);

    height: 26px;
    min-width: 60px;
    horizontal-stretch: 1;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.field;

    HorizontalLayout {
        prev := Rectangle {
            width: 22px;
            border-radius: 7px;
            background: prev-ta.has-hover && root.index > 0 ? Theme.hover : transparent;
            Text {
                text: "‹";
                color: root.index > 0 ? Theme.ink : Theme.muted.with-alpha(0.4);
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            prev-ta := TouchArea {
                mouse-cursor: root.index > 0 ? pointer : default;
                clicked => {
                    if (root.index > 0) {
                        root.index -= 1;
                        root.picked(root.index);
                    }
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.index >= 0 && root.index < root.options.length ? root.options[root.index] : "?";
            color: Theme.ink;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            width: 22px;
            border-radius: 7px;
            background: next-ta.has-hover && root.index < root.options.length - 1 ? Theme.hover : transparent;
            Text {
                text: "›";
                color: root.index < root.options.length - 1 ? Theme.ink : Theme.muted.with-alpha(0.4);
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            next-ta := TouchArea {
                mouse-cursor: root.index < root.options.length - 1 ? pointer : default;
                clicked => {
                    if (root.index < root.options.length - 1) {
                        root.index += 1;
                        root.picked(root.index);
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "TX Open Studio";
    icon: @image-url("../assets/icon.png");
    preferred-width: 960px;
    preferred-height: 1020px;
    min-width: 780px;
    min-height: 600px;
    background: Theme.bg;

    in-out property <int> preset: 43;
    in property <string> preset-name;
    // Character of the current preset ("" = unknown → no badge) and its
    // colour group (see PresetRow.kind).
    in property <string> preset-character;
    in property <int> preset-character-kind;
    // 150 list rows: bank number, character badge, name (empty until names load).
    in property <[PresetRow]> preset-names;
    in property <bool> connected: false;
    in property <string> status-text: "Pedal not connected";
    // Current preset modified since it was loaded (set/cleared from Rust).
    in property <bool> preset-dirty: false;

    // Amp knobs, 0..10. Set from Rust when read from the pedal.
    in-out property <float> amp-gain: 5;
    in-out property <float> amp-volume: 5;
    in-out property <float> amp-presence: 5;
    in-out property <float> amp-depth: 5;
    in-out property <float> amp-bass: 5;
    in-out property <float> amp-mid: 5;
    in-out property <float> amp-treble: 5;
    in-out property <bool> amp-enabled: true;
    // True while any amp knob is being dragged (Rust skips pedal updates then).
    out property <bool> knob-active: k-gain.active || k-volume.active || k-presence.active
        || k-depth.active || k-bass.active || k-mid.active || k-treble.active;

    callback preset-changed(int);
    callback reconnect();
    // User turned an amp knob. id: 0 gain, 1 volume, 2 presence, 3 depth,
    // 4 bass, 5 mid, 6 treble (matches AmpParam in main.rs).
    callback amp-param-changed(int, float);
    // User toggled the amp on/off chip.
    callback amp-enable-changed(bool);

    // Delay / Reverb blocks (values in pedal units; switches as bool,
    // selectors as option index). Set from Rust from the pedal's state.
    in-out property <bool> dly-enabled: false;
    in-out property <bool> dly-post: false;
    in-out property <int> dly-model: 0;
    in-out property <bool> dly-sync: false;
    in-out property <int> dly-division: 9;
    in-out property <float> dly-time: 320;
    in-out property <float> dly-feedback: 0;
    in-out property <bool> dly-pingpong: false;
    in-out property <float> dly-mix: 0;
    in-out property <bool> rvb-enabled: false;
    in-out property <bool> rvb-post: false;
    in-out property <int> rvb-model: 5;
    in-out property <float> rvb-time: 5;
    in-out property <float> rvb-predelay: 0;
    in-out property <float> rvb-color: 0;
    in-out property <float> rvb-mix: 0;
    // Pedal's time-signature list (index = value sent to the pedal).
    out property <[string]> delay-divisions: ["1/32", "1/32 D", "1/32 T", "1/16", "1/16 D", "1/16 T", "1/8", "1/8 D", "1/8 T",
        "1/4", "1/4 D", "1/4 T", "1/2", "1/2 D", "1/2 T", "1/1", "1/1 D", "1/1 T"];
    // User changed an effect control. id (matches FxControl in fx.rs):
    // 0 dly on, 1 dly post, 2 dly model, 3 dly sync, 4 dly division,
    // 5 dly time, 6 dly feedback, 7 dly ping-pong, 8 dly mix,
    // 10 rvb on, 11 rvb post, 12 rvb model, 13 rvb time, 14 rvb predelay,
    // 15 rvb color, 16 rvb mix,
    // 20 comp on, 21 comp post, 22 comp threshold, 23 comp gain, 24 comp attack,
    // 30 mod on, 31 mod post, 32 mod model, 33 mod sync, 34 mod division,
    // 35..38 mod knobs 1..4 of the selected type.
    callback fx-changed(int, float);

    // Compressor / Modulation (pedal units; see fx.rs).
    in-out property <bool> comp-enabled: false;
    in-out property <bool> comp-post: true;
    in-out property <float> comp-threshold: -14;
    in-out property <float> comp-gain: -12;
    in-out property <float> comp-attack: 14;
    in-out property <bool> mod-enabled: false;
    in-out property <bool> mod-post: false;
    in-out property <int> mod-model: 0;
    in-out property <bool> mod-sync: false;
    in-out property <int> mod-division: 9;
    in-out property <float> mod-k1: 0.5;
    in-out property <float> mod-k2: 0;
    in-out property <float> mod-k3: 5;
    in-out property <float> mod-k4: 5;

    // Global (pedal-wide) levels in dB. id 0 input trim, 1 master volume.
    in-out property <float> global-trim: 0;
    // Current preset's volume (0..10) and whether it has been read.
    in-out property <float> preset-level: 5;
    in property <bool> preset-level-known: false;
    callback preset-level-changed(float);
    in-out property <float> global-volume: 0;
    // Tuner on/off as last set by the app (the pedal doesn't report it).
    in-out property <bool> tuner-active: false;
    callback tuner-toggled(bool);
    callback global-changed(int, float);

    changed preset => {
        list.ensure-selected-visible();
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // App header, full width: keeps both columns' tops level.
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            Text {
                text: "TX Open Studio";
                color: Theme.ink;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            padding: 20px;
            padding-top: 16px;
            spacing: 20px;
            vertical-stretch: 1;

            // Left column: preset list
            VerticalLayout {
                width: 300px;

                // Preset list
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface-alt;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 12px;
                    clip: true;

                    list := ListView {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;

                        property <length> row-height: 34px;
                        property <bool> initial-scroll-done: false;

                        // Scrolls only when the selected row is (partly) out of
                        // view, then centers it. Clicking a visible row never
                        // moves the list.
                        function ensure-selected-visible() {
                            if (self.visible-height <= 0px) {
                                return;
                            }
                            let top = (root.preset - 1) * self.row-height;
                            let bottom = top + self.row-height;
                            if (top >= -self.content-y && bottom <= -self.content-y + self.visible-height) {
                                return;
                            }
                            let max-scroll = max(0px, self.content-height - self.visible-height);
                            let target = top - (self.visible-height - self.row-height) / 2;
                            self.content-y = -clamp(target, 0px, max-scroll);
                        }

                        changed visible-height => {
                            // First real layout pass: bring the startup preset into view.
                            if (!self.initial-scroll-done && self.visible-height > 0px) {
                                self.initial-scroll-done = true;
                                self.ensure-selected-visible();
                            }
                        }

                        for row[index] in root.preset-names: Rectangle {
                            height: list.row-height;

                            property <bool> is-selected: root.preset == index + 1;
                            property <string> number: index + 1;

                            Rectangle {
                                x: 0px;
                                width: parent.width;
                                height: parent.height;
                                border-radius: 8px;
                                background: is-selected ? Theme.selected : (row-ta.has-hover ? Theme.hover : transparent);

                                // number · [CHARACTER] · name; before names
                                // load only the bare preset number.
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 10px;
                                    spacing: 8px;

                                    Text {
                                        horizontal-stretch: 0;
                                        min-width: 20px;
                                        text: row.number == "" ? number : row.number;
                                        color: is-selected ? Theme.ink : Theme.muted;
                                        font-size: 13px;
                                        font-weight: is-selected ? 600 : 400;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: row.name;
                                        color: is-selected ? Theme.ink : Theme.secondary-ink;
                                        font-size: 14px;
                                        font-weight: is-selected ? 600 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }
                                    // Right-aligned badge; gray TONE when the
                                    // preset has no character in its metadata.
                                    if row.name != "": VerticalLayout {
                                        alignment: center;
                                        CharacterBadge {
                                            text: row.kind > 0 ? row.character : "TONE";
                                            kind: row.kind;
                                            font-size: 9px;
                                        }
                                    }
                                }

                                row-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.preset-changed(index + 1);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Right column: current preset header + effect tiles
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;

                // Header card
                Rectangle {
                    vertical-stretch: 0;
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 12px;

                    VerticalLayout {
                        padding: 18px;
                        // Tight: top line, name and badge sit close together.
                        spacing: 2px;

                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                // Pedal terms: 0-based bank (0..49) plus slot letter, e.g. 43 → "14-A".
                                text: "PRESET \{floor((root.preset - 1) / 3)}-\{["A", "B", "C"][mod(root.preset - 1, 3)]} / 49";
                                color: Theme.muted;
                                font-size: 11px;
                                font-weight: 600;
                                letter-spacing: 2px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                background: Theme.soft;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 3px;
                                    padding-bottom: 3px;
                                    Text {
                                        text: "Active";
                                        color: Theme.secondary-ink;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            // Current preset edited since it was loaded.
                            if root.preset-dirty: Rectangle {
                                background: Theme.changed.with-alpha(0.12);
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.changed.with-alpha(0.7);
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 3px;
                                    padding-bottom: 3px;
                                    Text {
                                        text: "Changed";
                                        color: Theme.changed;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 0px;
                            }
                            // Tuner on/off (MIDI CC9). The pedal reports no
                            // tuner state, so this shows what the app set.
                            // Square icon button, flush right.
                            StateButton {
                                horizontal-stretch: 0;
                                width: 32px;
                                height: 32px;
                                on <=> root.tuner-active;
                                on-text: "♯";
                                off-text: "♯";
                                toggled(on) => { root.tuner-toggled(on); }
                            }
                        }

                        // Preset name + character badge; replaced by the tuner
                        // display while the tuner is on (the knob row below
                        // stays). The name/badge stay in the layout, just
                        // hidden, so the card keeps its height.
                        Rectangle {
                            VerticalLayout {
                                spacing: 2px;
                                visible: !root.tuner-active;

                                // Name read over USB serial; falls back to the bare
                                // preset number until names are loaded.
                                Text {
                                    text: root.preset-name == "" ? root.preset : root.preset-name;
                                    color: Theme.ink;
                                    font-size: 30px;
                                    font-weight: 700;
                                    overflow: elide;
                                    wrap: no-wrap;
                                }
                                // Character from the preset's metadata; gray TONE
                                // when the preset doesn't name one.
                                if root.preset-name != "": HorizontalLayout {
                                    alignment: start;
                                    CharacterBadge {
                                        text: root.preset-character-kind > 0 ? root.preset-character : "TONE";
                                        kind: root.preset-character-kind;
                                        font-size: 11px;
                                    }
                                }
                            }

                            // Tuner mode. The pedal streams no pitch data, so the
                            // app can only point to the pedal's own display.
                            if root.tuner-active: VerticalLayout {
                                x: 0px;
                                y: 0px;
                                width: parent.width;
                                height: parent.height;
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: "TUNER";
                                    color: Theme.ok;
                                    font-size: 30px;
                                    font-weight: 700;
                                    letter-spacing: 4px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Tune on the pedal display";
                                    color: Theme.muted;
                                    font-size: 12px;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            padding-top: 12px;

                            // Per-preset output volume (pedal's PRESET VOLUME,
                            // 0..10; serial section 03, see tonex_serial.rs).
                            // Dimmed until read for this preset.
                            Knob {
                                horizontal-stretch: 0;
                                label: "Preset Vol";
                                size: 40px;
                                min-value: 0;
                                max-value: 10;
                                step: 0.1;
                                default-value: 5;
                                value <=> root.preset-level;
                                opacity: root.preset-level-known ? 1 : 0.5;
                                edited(v) => { root.preset-level-changed(v); }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 0px;
                            }

                            // Pedal-wide (global) levels, not stored per preset.
                            Knob {
                                horizontal-stretch: 0;
                                label: "In Trim";
                                size: 40px;
                                min-value: -15;
                                max-value: 15;
                                step: 0.1;
                                default-value: 0;
                                unit: " dB";
                                value <=> root.global-trim;
                                edited(v) => { root.global-changed(0, v); }
                            }
                            Knob {
                                horizontal-stretch: 0;
                                label: "Master";
                                size: 40px;
                                min-value: -40;
                                max-value: 3;
                                step: 0.1;
                                default-value: 0;
                                unit: " dB";
                                value <=> root.global-volume;
                                edited(v) => { root.global-changed(1, v); }
                            }
                        }
                    }
                }

                // Amplifier card: knobs send MIDI CCs, values are read from the
                // current preset over USB serial.
                Rectangle {
                    vertical-stretch: 0;
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 12px;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            Text {
                                horizontal-stretch: 1;
                                text: "Amplifier";
                                color: Theme.ink;
                                font-size: 17px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            // Amp enable/bypass toggle (written over USB serial).
                            OnOffChip {
                                on <=> root.amp-enabled;
                                toggled(on) => { root.amp-enable-changed(on); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            k-gain := Knob {
                                label: "Gain";
                                value <=> root.amp-gain;
                                edited(v) => { root.amp-param-changed(0, v); }
                            }
                            k-volume := Knob {
                                label: "Volume";
                                value <=> root.amp-volume;
                                edited(v) => { root.amp-param-changed(1, v); }
                            }
                            k-presence := Knob {
                                label: "Presence";
                                value <=> root.amp-presence;
                                edited(v) => { root.amp-param-changed(2, v); }
                            }
                            k-depth := Knob {
                                label: "Depth";
                                value <=> root.amp-depth;
                                edited(v) => { root.amp-param-changed(3, v); }
                            }
                            k-bass := Knob {
                                label: "Bass";
                                value <=> root.amp-bass;
                                edited(v) => { root.amp-param-changed(4, v); }
                            }
                            k-mid := Knob {
                                label: "Mid";
                                value <=> root.amp-mid;
                                edited(v) => { root.amp-param-changed(5, v); }
                            }
                            k-treble := Knob {
                                label: "Treble";
                                value <=> root.amp-treble;
                                edited(v) => { root.amp-param-changed(6, v); }
                            }
                        }
                    }
                }

                // Compressor + Modulation, side by side; written and read over
                // USB serial like Delay/Reverb (see fx.rs FxControl).
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 14px;

                    // Compressor card
                    Rectangle {
                        // Hard 50/50: explicit zero min/preferred widths
                        // override the content-derived ones, so equal
                        // stretch splits each FX row exactly in half and the
                        // seams of both rows line up at every window width.
                        // Content shrinks/elides and is clipped, never pushes.
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        clip: true;
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 12px;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            // Header, selector row, knob row at the same
                            // heights in every card; spare height goes below.
                            alignment: start;

                            HorizontalLayout {
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Compressor";
                                    color: Theme.ink;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                OnOffChip {
                                    on <=> root.comp-enabled;
                                    toggled(on) => { root.fx-changed(20, on ? 1 : 0); }
                                }
                            }
                            HorizontalLayout {
                                StateButton {
                                    on <=> root.comp-post;
                                    on-text: "Post amp";
                                    off-text: "Pre amp";
                                    toggled(on) => { root.fx-changed(21, on ? 1 : 0); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Knob {
                                    label: "Threshold";
                                    size: 40px;
                                    min-value: -40;
                                    max-value: 0;
                                    step: 0.1;
                                    default-value: -14;
                                    unit: " dB";
                                    value <=> root.comp-threshold;
                                    edited(v) => { root.fx-changed(22, v); }
                                }
                                Knob {
                                    label: "Gain";
                                    size: 40px;
                                    min-value: -30;
                                    max-value: 10;
                                    step: 0.1;
                                    default-value: -12;
                                    unit: " dB";
                                    value <=> root.comp-gain;
                                    edited(v) => { root.fx-changed(23, v); }
                                }
                                Knob {
                                    label: "Attack";
                                    size: 40px;
                                    min-value: 1;
                                    max-value: 51;
                                    step: 1;
                                    decimals: 0;
                                    default-value: 14;
                                    unit: " ms";
                                    value <=> root.comp-attack;
                                    edited(v) => { root.fx-changed(24, v); }
                                }
                            }
                        }
                    }

                    // Modulation card; knob set depends on the selected type.
                    Rectangle {
                        // Hard 50/50: explicit zero min/preferred widths
                        // override the content-derived ones, so equal
                        // stretch splits each FX row exactly in half and the
                        // seams of both rows line up at every window width.
                        // Content shrinks/elides and is clipped, never pushes.
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        clip: true;
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 12px;

                        // Per-type knob definitions, indexed by mod-model
                        // (Chorus, Tremolo, Phaser, Flanger, Rotary); ranges
                        // must match MOD_KNOBS in fx.rs.
                        property <int> m: clamp(root.mod-model, 0, 4);
                        property <bool> has-k4: m == 1 || m == 3 || m == 4;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            // Header, selector row, knob row at the same
                            // heights in every card; spare height goes below.
                            alignment: start;

                            HorizontalLayout {
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Modulation";
                                    color: Theme.ink;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                OnOffChip {
                                    on <=> root.mod-enabled;
                                    toggled(on) => { root.fx-changed(30, on ? 1 : 0); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Stepper {
                                    options: ["Chorus", "Tremolo", "Phaser", "Flanger", "Rotary"];
                                    index <=> root.mod-model;
                                    picked(i) => { root.fx-changed(32, i); }
                                }
                                StateButton {
                                    on <=> root.mod-post;
                                    on-text: "Post amp";
                                    off-text: "Pre amp";
                                    toggled(on) => { root.fx-changed(31, on ? 1 : 0); }
                                }
                                StateButton {
                                    on <=> root.mod-sync;
                                    on-text: "Sync On";
                                    off-text: "Sync Off";
                                    toggled(on) => { root.fx-changed(33, on ? 1 : 0); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                // Synced: note division instead of rate/speed.
                                if root.mod-sync: VerticalLayout {
                                    horizontal-stretch: 2;
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: "Division";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                    Stepper {
                                        options: root.delay-divisions;
                                        index <=> root.mod-division;
                                        picked(i) => { root.fx-changed(34, i); }
                                    }
                                }
                                if !root.mod-sync: Knob {
                                    label: m == 4 ? "Speed" : "Rate";
                                    size: 40px;
                                    min-value: m == 4 ? 0 : 0.1;
                                    max-value: m == 4 ? 400 : 10;
                                    step: m == 4 ? 1 : 0.1;
                                    decimals: m == 4 ? 0 : 1;
                                    unit: m == 4 ? "" : " Hz";
                                    default-value: m == 4 ? 200 : 0.5;
                                    value <=> root.mod-k1;
                                    edited(v) => { root.fx-changed(35, v); }
                                }
                                Knob {
                                    label: ["Depth", "Shape", "Depth", "Depth", "Radius"][m];
                                    size: 40px;
                                    min-value: 0;
                                    max-value: [100, 10, 100, 100, 300][m];
                                    step: m == 1 ? 0.1 : 1;
                                    decimals: m == 1 ? 1 : 0;
                                    unit: m == 1 || m == 4 ? "" : "%";
                                    default-value: m == 4 ? 150 : 0;
                                    value <=> root.mod-k2;
                                    edited(v) => { root.fx-changed(36, v); }
                                }
                                Knob {
                                    label: ["Level", "Spread", "Level", "Feedback", "Spread"][m];
                                    size: 40px;
                                    min-value: 0;
                                    max-value: [10, 100, 10, 100, 100][m];
                                    step: m == 0 || m == 2 ? 0.1 : 1;
                                    decimals: m == 0 || m == 2 ? 1 : 0;
                                    unit: m == 0 || m == 2 ? "" : "%";
                                    default-value: m == 0 || m == 2 ? 5 : 0;
                                    value <=> root.mod-k3;
                                    edited(v) => { root.fx-changed(37, v); }
                                }
                                if has-k4: Knob {
                                    label: "Level";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 10;
                                    step: 0.1;
                                    default-value: 5;
                                    value <=> root.mod-k4;
                                    edited(v) => { root.fx-changed(38, v); }
                                }
                            }
                        }
                    }
                }

                // Delay + Reverb, side by side. All values are written and
                // read over USB serial (see main.rs FxControl).
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 14px;

                    // Delay card
                    Rectangle {
                        // Hard 50/50: explicit zero min/preferred widths
                        // override the content-derived ones, so equal
                        // stretch splits each FX row exactly in half and the
                        // seams of both rows line up at every window width.
                        // Content shrinks/elides and is clipped, never pushes.
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        clip: true;
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 12px;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            // Header, selector row, knob row at the same
                            // heights in every card; spare height goes below.
                            alignment: start;

                            HorizontalLayout {
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Delay";
                                    color: Theme.ink;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                OnOffChip {
                                    on <=> root.dly-enabled;
                                    toggled(on) => { root.fx-changed(0, on ? 1 : 0); }
                                }
                            }
                            // One selector row, like every FX card.
                            HorizontalLayout {
                                spacing: 6px;
                                Stepper {
                                    options: ["Digital", "Tape"];
                                    index <=> root.dly-model;
                                    picked(i) => { root.fx-changed(2, i); }
                                }
                                StateButton {
                                    on <=> root.dly-post;
                                    on-text: "Post amp";
                                    off-text: "Pre amp";
                                    toggled(on) => { root.fx-changed(1, on ? 1 : 0); }
                                }
                                StateButton {
                                    on <=> root.dly-sync;
                                    on-text: "Sync On";
                                    off-text: "Sync Off";
                                    toggled(on) => { root.fx-changed(3, on ? 1 : 0); }
                                }
                                StateButton {
                                    on <=> root.dly-pingpong;
                                    on-text: "Ping-pong";
                                    off-text: "Normal";
                                    toggled(on) => { root.fx-changed(7, on ? 1 : 0); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                // Synced: note division instead of a time in ms.
                                if root.dly-sync: VerticalLayout {
                                    horizontal-stretch: 2;
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: "Division";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                    Stepper {
                                        options: root.delay-divisions;
                                        index <=> root.dly-division;
                                        picked(i) => { root.fx-changed(4, i); }
                                    }
                                }
                                if !root.dly-sync: Knob {
                                    label: "Time";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 1000;
                                    step: 1;
                                    decimals: 0;
                                    unit: " ms";
                                    default-value: 500;
                                    value <=> root.dly-time;
                                    edited(v) => { root.fx-changed(5, v); }
                                }
                                Knob {
                                    label: "Feedback";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 100;
                                    step: 1;
                                    decimals: 0;
                                    unit: "%";
                                    default-value: 0;
                                    value <=> root.dly-feedback;
                                    edited(v) => { root.fx-changed(6, v); }
                                }
                                Knob {
                                    label: "Mix";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 100;
                                    step: 1;
                                    decimals: 0;
                                    unit: "%";
                                    default-value: 0;
                                    value <=> root.dly-mix;
                                    edited(v) => { root.fx-changed(8, v); }
                                }
                            }
                        }
                    }

                    // Reverb card
                    Rectangle {
                        // Hard 50/50: explicit zero min/preferred widths
                        // override the content-derived ones, so equal
                        // stretch splits each FX row exactly in half and the
                        // seams of both rows line up at every window width.
                        // Content shrinks/elides and is clipped, never pushes.
                        horizontal-stretch: 1;
                        min-width: 0px;
                        preferred-width: 0px;
                        clip: true;
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 12px;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            // Header, selector row, knob row at the same
                            // heights in every card; spare height goes below.
                            alignment: start;

                            HorizontalLayout {
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Reverb";
                                    color: Theme.ink;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                OnOffChip {
                                    on <=> root.rvb-enabled;
                                    toggled(on) => { root.fx-changed(10, on ? 1 : 0); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Stepper {
                                    options: ["Spring 1", "Spring 2", "Spring 3", "Spring 4", "Room", "Plate"];
                                    index <=> root.rvb-model;
                                    picked(i) => { root.fx-changed(12, i); }
                                }
                                StateButton {
                                    on <=> root.rvb-post;
                                    on-text: "Post amp";
                                    off-text: "Pre amp";
                                    toggled(on) => { root.fx-changed(11, on ? 1 : 0); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Knob {
                                    label: "Time";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 10;
                                    step: 0.1;
                                    default-value: 5;
                                    value <=> root.rvb-time;
                                    edited(v) => { root.fx-changed(13, v); }
                                }
                                Knob {
                                    label: "Predelay";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 500;
                                    step: 1;
                                    decimals: 0;
                                    unit: " ms";
                                    default-value: 0;
                                    value <=> root.rvb-predelay;
                                    edited(v) => { root.fx-changed(14, v); }
                                }
                                Knob {
                                    label: "Mix";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 100;
                                    step: 1;
                                    decimals: 0;
                                    unit: "%";
                                    default-value: 0;
                                    value <=> root.rvb-mix;
                                    edited(v) => { root.fx-changed(16, v); }
                                }
                                Knob {
                                    label: "Color";
                                    size: 40px;
                                    min-value: -10;
                                    max-value: 10;
                                    step: 0.1;
                                    default-value: 0;
                                    value <=> root.rvb-color;
                                    edited(v) => { root.fx-changed(15, v); }
                                }
                            }
                        }
                    }
                }

                // Packs the right column's cards to the top.
                Rectangle {
                    vertical-stretch: 1;
                }
            }
        }

        // Status bar
        Rectangle {
            background: Theme.surface-alt;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.connected ? Theme.ok : Theme.error;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.status-text;
                        color: root.connected ? Theme.secondary-ink : Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    StyledButton {
                        width: 140px;
                        height: 30px;
                        text: "Reconnect";
                        font-size: 12px;
                        font-weight: 500;
                        clicked => {
                            root.reconnect();
                        }
                    }
                }
            }
        }
    }
}
