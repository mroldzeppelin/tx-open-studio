// TX Open Studio — preset switcher UI

import { ListView } from "std-widgets.slint";

export global Theme {
    out property <color> bg: #141b18;
    out property <color> surface: #1d2721;
    out property <color> surface-alt: #18211c;
    out property <color> soft: #28352c;
    out property <color> field: #202e25;
    out property <color> hover: #2b3a2f;
    out property <color> selected: #304934;
    out property <color> border: #3a4b3e;
    out property <color> selected-border: #86b778;
    out property <color> muted: #a6b6a3;
    out property <color> ink: #edf3e9;
    out property <color> secondary-ink: #bed4b2;
    out property <color> accent: #3e7750;
    out property <color> accent-hover: #4b8b5e;
    out property <color> ok: #86b778;
    out property <color> error: #c05b4d;
}

// Hand-made button: std-widgets don't follow the custom palette well.
component StyledButton inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 16px;
    in property <int> font-weight: 600;
    in property <bool> active: false;
    in property <color> base-color: Theme.soft;
    callback clicked();

    border-radius: 10px;
    border-width: 1px;
    border-color: root.active ? Theme.selected-border : Theme.border;
    background: ta.pressed ? Theme.selected : (ta.has-hover ? Theme.hover : root.base-color);
    min-height: 32px;
    min-width: 40px;

    animate background { duration: 90ms; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.ink : Theme.secondary-ink;
        font-size: root.font-size;
        font-weight: root.font-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Slot chip for one preset of the current bank (A/B/C).
component SlotChip inherits Rectangle {
    in property <string> letter;
    in property <string> label;
    in property <bool> active: false;
    callback clicked();

    min-width: 56px;
    preferred-width: 130px;
    horizontal-stretch: 0;
    height: 56px;
    border-radius: 10px;
    border-width: 1px;
    border-color: root.active ? Theme.selected-border : Theme.border;
    background: root.active ? Theme.selected : (ta.has-hover ? Theme.hover : Theme.field);

    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;

        Text {
            text: root.letter;
            color: root.active ? Theme.ink : Theme.secondary-ink;
            font-size: 16px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            horizontal-stretch: 1;
            text: root.label;
            color: root.active ? Theme.ink : Theme.secondary-ink;
            font-size: 13px;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
            wrap: no-wrap;
        }
    }

    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Two-line navigation button: title plus a small muted subtitle.
component NavButton inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> enabled: true;
    callback clicked();

    min-width: 84px;
    preferred-width: 140px;
    horizontal-stretch: 0;
    height: 56px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border;
    background: !root.enabled ? Theme.surface-alt : (ta.pressed ? Theme.selected : (ta.has-hover ? Theme.hover : Theme.soft));
    opacity: root.enabled ? 1.0 : 0.5;

    animate background { duration: 90ms; }

    VerticalLayout {
        alignment: center;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 2px;

        Text {
            text: root.title;
            color: Theme.ink;
            font-size: 14px;
            font-weight: 700;
            overflow: elide;
            wrap: no-wrap;
        }
        Text {
            text: root.subtitle;
            color: Theme.muted;
            font-size: 12px;
            overflow: elide;
            wrap: no-wrap;
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            root.clicked();
        }
    }
}

// Rotary knob with label above and value below. Vertical drag changes the
// value in `step` increments (a full sweep is ~150 px). `edited` fires only
// for user drags, not when the value is set programmatically (e.g. read back
// from the pedal). Shown with `decimals` (0 or 1) and a `unit` suffix.
component Knob inherits VerticalLayout {
    in property <string> label;
    in-out property <float> value: 5;
    in property <float> min-value: 0;
    in property <float> max-value: 10;
    in property <float> step: 0.1;
    in property <int> decimals: 1;
    in property <string> unit;
    in property <length> size: 48px;
    callback edited(float);
    out property <bool> active: ta.pressed;
    // Sweep of 270°: min → -135°, max → +135° (0° = straight up).
    property <float> frac: clamp((root.value - root.min-value) / max(root.max-value - root.min-value, 0.0001), 0, 1);
    property <angle> sweep: (-135 + root.frac * 270) * 1deg;
    property <int> tenths: round(root.value * 10);
    property <int> abs-tenths: abs(root.tenths);
    property <string> number: root.decimals == 0
        ? "\{round(root.value)}"
        : (root.tenths < 0 ? "-" : "") + "\{floor(root.abs-tenths / 10)}"
            + (mod(root.abs-tenths, 10) == 0 ? "" : ".\{mod(root.abs-tenths, 10)}");
    property <float> drag-start: 0;

    spacing: 4px;
    min-width: root.size;
    horizontal-stretch: 1;

    Text {
        text: root.label;
        color: Theme.muted;
        font-size: 12px;
        horizontal-alignment: center;
        overflow: elide;
        wrap: no-wrap;
    }

    HorizontalLayout {
        alignment: center;

        dial := Rectangle {
            width: root.size;
            height: root.size;
            border-radius: self.width / 2;
            background: Theme.field;
            border-width: 1px;
            border-color: ta.has-hover || ta.pressed ? Theme.muted : Theme.border;

            // Indicator dot on a circle of radius r, positioned via sin/cos.
            property <length> r: self.width / 2 - 9px;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.selected-border;
                x: dial.width / 2 + dial.r * sin(root.sweep) - self.width / 2;
                y: dial.height / 2 - dial.r * cos(root.sweep) - self.height / 2;
            }

            ta := TouchArea {
                mouse-cursor: ns-resize;
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.drag-start = root.value;
                    }
                }
                moved => {
                    if (self.pressed) {
                        let v = root.drag-start + (self.pressed-y - self.mouse-y) / 150px * (root.max-value - root.min-value);
                        let nv = clamp(round(v / root.step) * root.step, root.min-value, root.max-value);
                        if (nv != root.value) {
                            root.value = nv;
                            root.edited(nv);
                        }
                    }
                }
            }
        }
    }

    Text {
        text: root.number + root.unit;
        color: Theme.secondary-ink;
        font-size: 12px;
        font-family: "monospace";
        horizontal-alignment: center;
        overflow: elide;
        wrap: no-wrap;
    }
}

// On/Off chip for an effect block header: green dot + "On", muted "Off".
component OnOffChip inherits Rectangle {
    in-out property <bool> on: true;
    callback toggled(bool);

    horizontal-stretch: 0;
    background: chip-ta.pressed ? Theme.selected : (chip-ta.has-hover ? Theme.hover : Theme.soft);
    border-radius: 6px;
    border-width: 1px;
    border-color: root.on ? Theme.ok : Theme.border;
    animate background { duration: 90ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 3px;
        padding-bottom: 3px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: root.on ? Theme.ok : Theme.muted.with-alpha(0.5);
            }
        }
        Text {
            text: root.on ? "On" : "Off";
            color: root.on ? Theme.ink : Theme.muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
    chip-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// Small two-state button whose caption names the current state
// ("Pre amp" / "Post amp"); highlighted when `on`.
component StateButton inherits Rectangle {
    in-out property <bool> on;
    in property <string> on-text;
    in property <string> off-text;
    callback toggled(bool);

    height: 26px;
    min-width: 56px;
    horizontal-stretch: 1;
    border-radius: 7px;
    border-width: 1px;
    border-color: root.on ? Theme.selected-border : Theme.border;
    background: sb-ta.pressed ? Theme.selected : (sb-ta.has-hover ? Theme.hover : Theme.field);
    animate background { duration: 90ms; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.on ? root.on-text : root.off-text;
        color: root.on ? Theme.ink : Theme.secondary-ink;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    sb-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.on = !root.on;
            root.toggled(root.on);
        }
    }
}

// Compact selector: ‹ label › cycling through `options` (no wrap-around).
component Stepper inherits Rectangle {
    in property <[string]> options;
    in-out property <int> index;
    callback picked(int);

    height: 26px;
    min-width: 84px;
    horizontal-stretch: 1;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.field;

    HorizontalLayout {
        prev := Rectangle {
            width: 22px;
            border-radius: 7px;
            background: prev-ta.has-hover && root.index > 0 ? Theme.hover : transparent;
            Text {
                text: "‹";
                color: root.index > 0 ? Theme.ink : Theme.muted.with-alpha(0.4);
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            prev-ta := TouchArea {
                mouse-cursor: root.index > 0 ? pointer : default;
                clicked => {
                    if (root.index > 0) {
                        root.index -= 1;
                        root.picked(root.index);
                    }
                }
            }
        }
        Text {
            horizontal-stretch: 1;
            text: root.index >= 0 && root.index < root.options.length ? root.options[root.index] : "?";
            color: Theme.ink;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            width: 22px;
            border-radius: 7px;
            background: next-ta.has-hover && root.index < root.options.length - 1 ? Theme.hover : transparent;
            Text {
                text: "›";
                color: root.index < root.options.length - 1 ? Theme.ink : Theme.muted.with-alpha(0.4);
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            next-ta := TouchArea {
                mouse-cursor: root.index < root.options.length - 1 ? pointer : default;
                clicked => {
                    if (root.index < root.options.length - 1) {
                        root.index += 1;
                        root.picked(root.index);
                    }
                }
            }
        }
    }
}

// Segmented buttons, one of `options` selected.
component Segmented inherits HorizontalLayout {
    in property <[string]> options;
    in-out property <int> index;
    callback picked(int);

    spacing: 4px;
    horizontal-stretch: 1;
    for opt[i] in root.options: Rectangle {
        height: 26px;
        min-width: 44px;
        horizontal-stretch: 1;
        border-radius: 7px;
        border-width: 1px;
        border-color: root.index == i ? Theme.selected-border : Theme.border;
        background: root.index == i ? Theme.selected : (seg-ta.has-hover ? Theme.hover : Theme.field);
        Text {
            text: opt;
            color: root.index == i ? Theme.ink : Theme.secondary-ink;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        seg-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => {
                if (root.index != i) {
                    root.index = i;
                    root.picked(i);
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    title: "TX Open Studio";
    preferred-width: 960px;
    preferred-height: 860px;
    min-width: 780px;
    min-height: 600px;
    background: Theme.bg;

    in-out property <int> preset: 43;
    in property <string> preset-name;
    // 150 display labels ("41 FULDRV"); a bare number or "" until names load.
    in property <[string]> preset-names;
    in property <bool> connected: false;
    in property <string> status-text: "Pedal not connected";

    // Amp knobs, 0..10. Set from Rust when read from the pedal.
    in-out property <float> amp-gain: 5;
    in-out property <float> amp-volume: 5;
    in-out property <float> amp-presence: 5;
    in-out property <float> amp-depth: 5;
    in-out property <float> amp-bass: 5;
    in-out property <float> amp-mid: 5;
    in-out property <float> amp-treble: 5;
    in-out property <bool> amp-enabled: true;
    // True while any amp knob is being dragged (Rust skips pedal updates then).
    out property <bool> knob-active: k-gain.active || k-volume.active || k-presence.active
        || k-depth.active || k-bass.active || k-mid.active || k-treble.active;

    callback preset-changed(int);
    callback reconnect();
    // User turned an amp knob. id: 0 gain, 1 volume, 2 presence, 3 depth,
    // 4 bass, 5 mid, 6 treble (matches AmpParam in main.rs).
    callback amp-param-changed(int, float);
    // User toggled the amp on/off chip.
    callback amp-enable-changed(bool);

    // Delay / Reverb blocks (values in pedal units; switches as bool,
    // selectors as option index). Set from Rust from the pedal's state.
    in-out property <bool> dly-enabled: false;
    in-out property <bool> dly-post: false;
    in-out property <int> dly-model: 0;
    in-out property <bool> dly-sync: false;
    in-out property <int> dly-division: 9;
    in-out property <float> dly-time: 320;
    in-out property <float> dly-feedback: 0;
    in-out property <bool> dly-pingpong: false;
    in-out property <float> dly-mix: 0;
    in-out property <bool> rvb-enabled: false;
    in-out property <bool> rvb-post: false;
    in-out property <int> rvb-model: 5;
    in-out property <float> rvb-time: 5;
    in-out property <float> rvb-predelay: 0;
    in-out property <float> rvb-color: 0;
    in-out property <float> rvb-mix: 0;
    // Pedal's time-signature list (index = value sent to the pedal).
    out property <[string]> delay-divisions: ["1/32", "1/32 D", "1/32 T", "1/16", "1/16 D", "1/16 T", "1/8", "1/8 D", "1/8 T",
        "1/4", "1/4 D", "1/4 T", "1/2", "1/2 D", "1/2 T", "1/1", "1/1 D", "1/1 T"];
    // User changed a delay/reverb control. id (matches FxControl in main.rs):
    // 0 dly on, 1 dly post, 2 dly model, 3 dly sync, 4 dly division,
    // 5 dly time, 6 dly feedback, 7 dly ping-pong, 8 dly mix,
    // 10 rvb on, 11 rvb post, 12 rvb model, 13 rvb time, 14 rvb predelay,
    // 15 rvb color, 16 rvb mix.
    callback fx-changed(int, float);

    // Label of preset `p` (1-based) from the list model; "" when out of range,
    // the bare number when the name is not loaded yet.
    pure function label-for(p: int) -> string {
        if (p < 1 || p > root.preset-names.length) {
            return "";
        }
        let name = root.preset-names[p - 1];
        return name == "" ? "\{p}" : name;
    }

    // First preset of the current bank of 3 (A slot).
    property <int> bank-first: floor((root.preset - 1) / 3) * 3 + 1;

    changed preset => {
        list.ensure-selected-visible();
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // App header, full width: keeps both columns' tops level.
        HorizontalLayout {
            padding-left: 20px;
            padding-right: 20px;
            padding-top: 16px;
            Text {
                text: "TX Open Studio";
                color: Theme.ink;
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        HorizontalLayout {
            padding: 20px;
            padding-top: 16px;
            spacing: 20px;
            vertical-stretch: 1;

            // Left column: preset list
            VerticalLayout {
                width: 300px;

                // Preset list
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.surface-alt;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 12px;
                    clip: true;

                    list := ListView {
                        x: 4px;
                        y: 4px;
                        width: parent.width - 8px;
                        height: parent.height - 8px;

                        property <length> row-height: 34px;
                        property <bool> initial-scroll-done: false;

                        // Scrolls only when the selected row is (partly) out of
                        // view, then centers it. Clicking a visible row never
                        // moves the list.
                        function ensure-selected-visible() {
                            if (self.visible-height <= 0px) {
                                return;
                            }
                            let top = (root.preset - 1) * self.row-height;
                            let bottom = top + self.row-height;
                            if (top >= -self.content-y && bottom <= -self.content-y + self.visible-height) {
                                return;
                            }
                            let max-scroll = max(0px, self.content-height - self.visible-height);
                            let target = top - (self.visible-height - self.row-height) / 2;
                            self.content-y = -clamp(target, 0px, max-scroll);
                        }

                        changed visible-height => {
                            // First real layout pass: bring the startup preset into view.
                            if (!self.initial-scroll-done && self.visible-height > 0px) {
                                self.initial-scroll-done = true;
                                self.ensure-selected-visible();
                            }
                        }

                        for name[index] in root.preset-names: Rectangle {
                            height: list.row-height;

                            property <bool> is-selected: root.preset == index + 1;
                            property <string> number: index + 1;

                            Rectangle {
                                x: 0px;
                                width: parent.width;
                                height: parent.height;
                                border-radius: 8px;
                                background: is-selected ? Theme.selected : (row-ta.has-hover ? Theme.hover : transparent);

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 10px;

                                    Text {
                                        horizontal-stretch: 1;
                                        // Before names load the label is the bare number.
                                        text: name == "" ? number : name;
                                        color: is-selected ? Theme.ink : Theme.secondary-ink;
                                        font-size: 14px;
                                        font-weight: is-selected ? 600 : 400;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        wrap: no-wrap;
                                    }
                                }

                                row-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.preset-changed(index + 1);
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Right column: current preset header + effect tiles
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 12px;

                // Header card
                Rectangle {
                    vertical-stretch: 0;
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 12px;

                    VerticalLayout {
                        padding: 18px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: start;
                            Text {
                                // Pedal terms: 0-based bank (0..49) plus slot letter, e.g. 43 → "14-A".
                                text: "PRESET \{floor((root.preset - 1) / 3)}-\{["A", "B", "C"][mod(root.preset - 1, 3)]} / 49";
                                color: Theme.muted;
                                font-size: 11px;
                                font-weight: 600;
                                letter-spacing: 2px;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                background: Theme.soft;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: Theme.border;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-top: 3px;
                                    padding-bottom: 3px;
                                    Text {
                                        text: "Active";
                                        color: Theme.secondary-ink;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Name read over USB serial; falls back to the bare
                        // preset number until names are loaded.
                        Text {
                            text: root.preset-name == "" ? root.preset : root.preset-name;
                            color: Theme.ink;
                            font-size: 30px;
                            font-weight: 700;
                            overflow: elide;
                            wrap: no-wrap;
                        }

                        HorizontalLayout {
                            spacing: 8px;

                            for slot[i] in ["A", "B", "C"]: SlotChip {
                                letter: slot;
                                label: root.label-for(root.bank-first + i);
                                active: root.preset == root.bank-first + i;
                                clicked => {
                                    root.preset-changed(root.bank-first + i);
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                min-width: 0px;
                            }

                            NavButton {
                                title: "← Previous";
                                subtitle: root.label-for(root.preset - 1);
                                enabled: root.preset > 1;
                                clicked => {
                                    root.preset-changed(root.preset - 1);
                                }
                            }
                            NavButton {
                                title: "Next →";
                                subtitle: root.label-for(root.preset + 1);
                                enabled: root.preset < 150;
                                clicked => {
                                    root.preset-changed(root.preset + 1);
                                }
                            }
                        }
                    }
                }

                // Amplifier card: knobs send MIDI CCs, values are read from the
                // current preset over USB serial.
                Rectangle {
                    vertical-stretch: 0;
                    background: Theme.surface;
                    border-color: Theme.border;
                    border-width: 1px;
                    border-radius: 12px;

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        HorizontalLayout {
                            Text {
                                horizontal-stretch: 1;
                                text: "Amplifier";
                                color: Theme.ink;
                                font-size: 17px;
                                font-weight: 700;
                                vertical-alignment: center;
                            }
                            // Amp enable/bypass toggle (written over USB serial).
                            OnOffChip {
                                on <=> root.amp-enabled;
                                toggled(on) => { root.amp-enable-changed(on); }
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            k-gain := Knob {
                                label: "Gain";
                                value <=> root.amp-gain;
                                edited(v) => { root.amp-param-changed(0, v); }
                            }
                            k-volume := Knob {
                                label: "Volume";
                                value <=> root.amp-volume;
                                edited(v) => { root.amp-param-changed(1, v); }
                            }
                            k-presence := Knob {
                                label: "Presence";
                                value <=> root.amp-presence;
                                edited(v) => { root.amp-param-changed(2, v); }
                            }
                            k-depth := Knob {
                                label: "Depth";
                                value <=> root.amp-depth;
                                edited(v) => { root.amp-param-changed(3, v); }
                            }
                            k-bass := Knob {
                                label: "Bass";
                                value <=> root.amp-bass;
                                edited(v) => { root.amp-param-changed(4, v); }
                            }
                            k-mid := Knob {
                                label: "Mid";
                                value <=> root.amp-mid;
                                edited(v) => { root.amp-param-changed(5, v); }
                            }
                            k-treble := Knob {
                                label: "Treble";
                                value <=> root.amp-treble;
                                edited(v) => { root.amp-param-changed(6, v); }
                            }
                        }
                    }
                }

                // Delay + Reverb, side by side. All values are written and
                // read over USB serial (see main.rs FxControl).
                HorizontalLayout {
                    vertical-stretch: 0;
                    spacing: 14px;

                    // Delay card
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 12px;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Delay";
                                    color: Theme.ink;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                OnOffChip {
                                    on <=> root.dly-enabled;
                                    toggled(on) => { root.fx-changed(0, on ? 1 : 0); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Segmented {
                                    options: ["Digital", "Tape"];
                                    index <=> root.dly-model;
                                    picked(i) => { root.fx-changed(2, i); }
                                }
                                StateButton {
                                    on <=> root.dly-post;
                                    on-text: "Post amp";
                                    off-text: "Pre amp";
                                    toggled(on) => { root.fx-changed(1, on ? 1 : 0); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                StateButton {
                                    on <=> root.dly-sync;
                                    on-text: "Sync On";
                                    off-text: "Sync Off";
                                    toggled(on) => { root.fx-changed(3, on ? 1 : 0); }
                                }
                                StateButton {
                                    on <=> root.dly-pingpong;
                                    on-text: "Ping-pong";
                                    off-text: "Normal";
                                    toggled(on) => { root.fx-changed(7, on ? 1 : 0); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                // Synced: note division instead of a time in ms.
                                if root.dly-sync: VerticalLayout {
                                    horizontal-stretch: 2;
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: "Division";
                                        color: Theme.muted;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                    }
                                    Stepper {
                                        options: root.delay-divisions;
                                        index <=> root.dly-division;
                                        picked(i) => { root.fx-changed(4, i); }
                                    }
                                }
                                if !root.dly-sync: Knob {
                                    label: "Time";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 1000;
                                    step: 1;
                                    decimals: 0;
                                    unit: " ms";
                                    value <=> root.dly-time;
                                    edited(v) => { root.fx-changed(5, v); }
                                }
                                Knob {
                                    label: "Feedback";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 100;
                                    step: 1;
                                    decimals: 0;
                                    unit: "%";
                                    value <=> root.dly-feedback;
                                    edited(v) => { root.fx-changed(6, v); }
                                }
                                Knob {
                                    label: "Mix";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 100;
                                    step: 1;
                                    decimals: 0;
                                    unit: "%";
                                    value <=> root.dly-mix;
                                    edited(v) => { root.fx-changed(8, v); }
                                }
                            }
                        }
                    }

                    // Reverb card
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.surface;
                        border-color: Theme.border;
                        border-width: 1px;
                        border-radius: 12px;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;

                            HorizontalLayout {
                                Text {
                                    horizontal-stretch: 1;
                                    text: "Reverb";
                                    color: Theme.ink;
                                    font-size: 15px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                OnOffChip {
                                    on <=> root.rvb-enabled;
                                    toggled(on) => { root.fx-changed(10, on ? 1 : 0); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Stepper {
                                    options: ["Spring 1", "Spring 2", "Spring 3", "Spring 4", "Room", "Plate"];
                                    index <=> root.rvb-model;
                                    picked(i) => { root.fx-changed(12, i); }
                                }
                                StateButton {
                                    on <=> root.rvb-post;
                                    on-text: "Post amp";
                                    off-text: "Pre amp";
                                    toggled(on) => { root.fx-changed(11, on ? 1 : 0); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 6px;
                                Knob {
                                    label: "Time";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 10;
                                    step: 0.1;
                                    value <=> root.rvb-time;
                                    edited(v) => { root.fx-changed(13, v); }
                                }
                                Knob {
                                    label: "Predelay";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 500;
                                    step: 1;
                                    decimals: 0;
                                    unit: " ms";
                                    value <=> root.rvb-predelay;
                                    edited(v) => { root.fx-changed(14, v); }
                                }
                                Knob {
                                    label: "Mix";
                                    size: 40px;
                                    min-value: 0;
                                    max-value: 100;
                                    step: 1;
                                    decimals: 0;
                                    unit: "%";
                                    value <=> root.rvb-mix;
                                    edited(v) => { root.fx-changed(16, v); }
                                }
                                Knob {
                                    label: "Color";
                                    size: 40px;
                                    min-value: -10;
                                    max-value: 10;
                                    step: 0.1;
                                    value <=> root.rvb-color;
                                    edited(v) => { root.fx-changed(15, v); }
                                }
                            }
                        }
                    }
                }

                // Packs the right column's cards to the top.
                Rectangle {
                    vertical-stretch: 1;
                }
            }
        }

        // Status bar
        Rectangle {
            background: Theme.surface-alt;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.connected ? Theme.ok : Theme.error;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.status-text;
                        color: root.connected ? Theme.secondary-ink : Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    StyledButton {
                        width: 140px;
                        height: 30px;
                        text: "Reconnect";
                        font-size: 12px;
                        font-weight: 500;
                        clicked => {
                            root.reconnect();
                        }
                    }
                }
            }
        }
    }
}
