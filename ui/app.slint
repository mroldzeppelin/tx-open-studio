// TX Open Studio — preset switcher UI

import { ListView } from "std-widgets.slint";

export global Theme {
    out property <color> bg: #141b18;
    out property <color> surface: #1d2721;
    out property <color> surface-alt: #18211c;
    out property <color> soft: #28352c;
    out property <color> field: #202e25;
    out property <color> hover: #2b3a2f;
    out property <color> selected: #304934;
    out property <color> border: #3a4b3e;
    out property <color> selected-border: #86b778;
    out property <color> muted: #a6b6a3;
    out property <color> ink: #edf3e9;
    out property <color> secondary-ink: #bed4b2;
    out property <color> accent: #3e7750;
    out property <color> accent-hover: #4b8b5e;
    out property <color> ok: #86b778;
    out property <color> error: #c05b4d;
}

// Hand-made button: std-widgets don't follow the custom palette well.
component StyledButton inherits Rectangle {
    in property <string> text;
    in property <length> font-size: 16px;
    in property <int> font-weight: 600;
    in property <bool> active: false;
    in property <color> base-color: Theme.soft;
    callback clicked();

    border-radius: 10px;
    border-width: 1px;
    border-color: root.active ? Theme.selected-border : Theme.border;
    background: ta.pressed ? Theme.selected : (ta.has-hover ? Theme.hover : root.base-color);
    min-height: 32px;
    min-width: 40px;

    animate background { duration: 90ms; }

    Text {
        width: parent.width;
        height: parent.height;
        text: root.text;
        color: root.active ? Theme.ink : Theme.secondary-ink;
        font-size: root.font-size;
        font-weight: root.font-weight;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

export component AppWindow inherits Window {
    title: "TX Open Studio";
    preferred-width: 420px;
    preferred-height: 560px;
    min-width: 360px;
    min-height: 420px;
    background: Theme.bg;

    in-out property <int> preset: 43;
    in property <string> preset-name;
    // 150 display labels ("41.FULDRV"); a bare number or "" until names load.
    in property <[string]> preset-names;
    in property <bool> connected: false;
    in property <string> status-text: "Педаль не подключена";

    callback preset-changed(int);
    callback reconnect();

    changed preset => {
        list.ensure-selected-visible();
    }

    VerticalLayout {
        padding: 0px;
        spacing: 0px;

        // Main content
        VerticalLayout {
            padding: 20px;
            spacing: 16px;
            vertical-stretch: 1;

            // Header
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "TX Open Studio";
                    color: Theme.ink;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Text {
                    text: "PRESETS";
                    color: Theme.muted;
                    font-size: 11px;
                    font-weight: 600;
                    letter-spacing: 1.5px;
                    vertical-alignment: center;
                }
            }

            // Preset card
            Rectangle {
                height: 96px;
                background: Theme.surface;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 12px;

                VerticalLayout {
                    alignment: center;
                    padding: 16px;
                    spacing: 8px;

                    // Name read over USB serial; falls back to the bare
                    // preset number until names are loaded.
                    Text {
                        text: root.preset-name == "" ? root.preset : root.preset-name;
                        color: Theme.ink;
                        font-size: 32px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        overflow: elide;
                        wrap: no-wrap;
                    }
                }
            }

            // Prev / Next
            HorizontalLayout {
                spacing: 12px;
                StyledButton {
                    horizontal-stretch: 1;
                    height: 56px;
                    text: "← PREV";
                    font-size: 18px;
                    clicked => {
                        root.preset-changed(root.preset - 1);
                    }
                }
                StyledButton {
                    horizontal-stretch: 1;
                    height: 56px;
                    text: "NEXT →";
                    font-size: 18px;
                    clicked => {
                        root.preset-changed(root.preset + 1);
                    }
                }
            }

            // Preset list
            Rectangle {
                vertical-stretch: 1;
                background: Theme.surface-alt;
                border-color: Theme.border;
                border-width: 1px;
                border-radius: 12px;
                clip: true;

                list := ListView {
                    x: 4px;
                    y: 4px;
                    width: parent.width - 8px;
                    height: parent.height - 8px;

                    property <length> row-height: 34px;
                    property <bool> initial-scroll-done: false;

                    // Scrolls only when the selected row is (partly) out of
                    // view, then centers it. Clicking a visible row never
                    // moves the list.
                    function ensure-selected-visible() {
                        if (self.visible-height <= 0px) {
                            return;
                        }
                        let top = (root.preset - 1) * self.row-height;
                        let bottom = top + self.row-height;
                        if (top >= -self.content-y && bottom <= -self.content-y + self.visible-height) {
                            return;
                        }
                        let max-scroll = max(0px, self.content-height - self.visible-height);
                        let target = top - (self.visible-height - self.row-height) / 2;
                        self.content-y = -clamp(target, 0px, max-scroll);
                    }

                    changed visible-height => {
                        // First real layout pass: bring the startup preset into view.
                        if (!self.initial-scroll-done && self.visible-height > 0px) {
                            self.initial-scroll-done = true;
                            self.ensure-selected-visible();
                        }
                    }

                    for name[index] in root.preset-names: Rectangle {
                        height: list.row-height;

                        property <bool> is-selected: root.preset == index + 1;
                        property <string> number: index + 1;

                        Rectangle {
                            x: 0px;
                            width: parent.width;
                            height: parent.height;
                            border-radius: 8px;
                            background: is-selected ? Theme.selected : (row-ta.has-hover ? Theme.hover : transparent);

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 10px;

                                Text {
                                    horizontal-stretch: 1;
                                    // Before names load the label is the bare number.
                                    text: name == "" ? number : name;
                                    color: is-selected ? Theme.ink : Theme.secondary-ink;
                                    font-size: 14px;
                                    font-weight: is-selected ? 600 : 400;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    wrap: no-wrap;
                                }
                            }

                            row-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.preset-changed(index + 1);
                                }
                            }
                        }
                    }
                }
            }
        }

        // Status bar
        Rectangle {
            background: Theme.surface-alt;

            VerticalLayout {
                padding: 0px;
                spacing: 0px;

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 12px;
                    padding-top: 8px;
                    padding-bottom: 8px;
                    spacing: 10px;

                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 10px;
                            height: 10px;
                            border-radius: 5px;
                            background: root.connected ? Theme.ok : Theme.error;
                        }
                    }

                    Text {
                        horizontal-stretch: 1;
                        text: root.status-text;
                        color: root.connected ? Theme.secondary-ink : Theme.muted;
                        font-size: 12px;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    StyledButton {
                        width: 140px;
                        height: 30px;
                        text: "Переподключить";
                        font-size: 12px;
                        font-weight: 500;
                        clicked => {
                            root.reconnect();
                        }
                    }
                }
            }
        }
    }
}
